<!-- TrueToneCap/Directory.Packages.props
     依赖版本的单一事实源（NuGet 集中式包版本管理 / Central Package Management）。

     各 csproj 的 <PackageReference> 只写包名，**不再写 Version 属性**。
     升级某个依赖 → 只改这里一处。

     注意: 本文件由 NuGet 自动导入（与 Directory.Build.props 同级，无需显式 Import）。
           若需临时绕过集中管理，可在单个 PackageReference 上写
           VersionOverride="x.y.z"。

     核实版本号请查: https://api.nuget.org/v3-flatcontainer/<包名小写>/index.json -->
<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- 版本冲突时视为错误，避免静默降级到较旧版本 -->
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- ── UI 框架 (App / LogViewer) ── -->
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageVersion Include="Microsoft.Graphics.Win2D" Version="1.4.0" />

    <!-- ── 依赖注入 (App) ──
         2026-09-15 降级至 10.0.12（.NET 10 LTS 线最新稳定版）。
         原为 11.0.0-rc.1 —— 那是**预发布**包，存在被下架/取消列出的风险，
         全新机器（无本地 NuGet 缓存）还原会直接 NU1101。
         实测 10.0.12 在 net11.0 TFM 上可正常还原/构建/通过门禁；
         本项目已在混用 10.x 包（System.Drawing.Common 10.0.11），无兼容性问题。
         ⚠️ 这不解决根本问题：TFM 仍是 net11.0-windows、SDK 仍是 11.0.100-preview.7，
            整体仍属预发布基线；待 .NET 11 GA 后应整体评估升回 11.x。 -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />

    <!-- ── 推理 / 图形 (Core) ── -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
    <PackageVersion Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageVersion Include="Vortice.DXGI" Version="3.8.3" />

    <!-- ── 编码 (Core) ──
         MozJpegSharp.Core 已移除（2026-09-21 许可合规轮）：零引用死重量，
         理由与取证见 src/TrueToneCap.Core/TrueToneCap.Core.csproj 原位注释。 -->

    <!-- ── 测试 / 工具 (Test / Tools) ──
         仅用于生成测试图，不随主程序发布。 -->
    <PackageVersion Include="System.Drawing.Common" Version="10.0.11" />
  </ItemGroup>

</Project>
