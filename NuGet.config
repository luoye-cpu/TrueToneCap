<?xml version="1.0" encoding="utf-8"?>
<!-- TrueToneCap/NuGet.config
     还原源的单一声明处 —— 与 Directory.Packages.props（版本）互为补充。

     目的:
      · clear 元素丢弃机器级/用户级配置里可能存在的私有源、内部源、被劫持的源，
        保证「任何人、任何机器、CI」还原出的包集合完全一致。
      · auditSources 让 NuGetAudit 与「易受攻击包」查询的漏洞数据源也固定为
        nuget.org，避免漏洞审计被本地配置静默关闭。

     ⚠️ 本文件必须提交到版本控制。
        注意 .gitignore 曾有一条 NuGet.Config 规则会屏蔽它，
        该规则已于 2026-09-14 移除 —— 若本文件显示为被忽略，请检查 .gitignore。

     若将来确需内部源，请在此处显式添加，而不是依赖机器级配置。

     注: XML 注释内禁止出现连续两个短横线，故上文的命令行选项未写全形。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <auditSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </auditSources>
</configuration>
