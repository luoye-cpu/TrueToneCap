<!-- TrueToneCap.App/App.xaml -->
<Application
    x:Class="TrueToneCap.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- ═══ 覆盖 WinUI 主题字体 ═══ -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <FontFamily x:Key="ContentControlThemeFontFamily">Microsoft YaHei, Segoe UI, sans-serif</FontFamily>
                    <FontFamily x:Key="TextControlThemeFontFamily">Microsoft YaHei, Segoe UI, sans-serif</FontFamily>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <FontFamily x:Key="ContentControlThemeFontFamily">Microsoft YaHei, Segoe UI, sans-serif</FontFamily>
                    <FontFamily x:Key="TextControlThemeFontFamily">Microsoft YaHei, Segoe UI, sans-serif</FontFamily>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <FontFamily x:Key="ContentControlThemeFontFamily">Microsoft YaHei, Segoe UI, sans-serif</FontFamily>
                    <FontFamily x:Key="TextControlThemeFontFamily">Microsoft YaHei, Segoe UI, sans-serif</FontFamily>
                </ResourceDictionary>
                <!-- WCAG 2.1 AA: High contrast theme for accessibility mode (2026-11-08) -->
                <ResourceDictionary x:Key="HighContrast">
                    <FontFamily x:Key="ContentControlThemeFontFamily">Microsoft YaHei, Segoe UI, sans-serif</FontFamily>
                    <FontFamily x:Key="TextControlThemeFontFamily">Microsoft YaHei, Segoe UI, sans-serif</FontFamily>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!--
                    ═══ 2026-11-16 修复：HighContrastTheme.xaml 不再全局合并 ═══
                    它把 SolidBackgroundFillColorBase / CardBackgroundFillColorDefault 硬编码成白色，
                    又把 CardStrokeColorDefaultBrush 硬编码成黑色；在深色或系统高对比度主题下，
                    默认 TextBlock/ComboBox 前景仍是白色 ⇒ 白底白字（商店用户实测截图）。
                    高对比度模式交给 WinUI 自带的 HighContrast 主题资源；本字典只保留文件作审计参考，
                    禁止再放回 MergedDictionaries。需要自定义高对比样式时必须使用 SystemColor* 画笔，
                    不得硬编码浅色 surface。
                -->
                <!-- WCAG 2.1 AA: Focus visual enhancement styles (2026-11-08) -->
                <ResourceDictionary Source="ms-appx:///Resources/FocusVisualStyles.xaml"/>
                <!-- WCAG 2.1 AA: General accessibility enhancements (2026-11-08) -->
                <ResourceDictionary Source="ms-appx:///Resources/AccessibilityEnhancements.xaml"/>
                <!-- WCAG 2.1 AA: NavigationView items accessibility (2026-11-08) -->
                <ResourceDictionary Source="ms-appx:///Resources/NavigationViewAccessibilityEnhancements.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 全局默认字体隐式回退 -->
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Microsoft YaHei, Segoe UI, sans-serif" />
            </Style>
            <Style TargetType="Control">
                <Setter Property="FontFamily" Value="Microsoft YaHei, Segoe UI, sans-serif" />
            </Style>

            <!-- 这里原来有一份隐式的 FontIcon 样式，把字体族写死成某个系统符号字体族，注释写着
                 "否则图标字形无法渲染"——那句是错的：本进程按字体友好名解析符号字体本来就失败
                 （报告 §11-②），而全仓 XAML 已无任何 FontIcon 元素（图标一律 PathIcon 字形轮廓）。
                 23:11 A/B 实测：删掉它之后主窗默认页（含一枚可见的下拉箭头）逐像素零差异
                 （tests/output/realmachine-2026-10-01/mainwindow-swapped.png vs mainwindow-nostyle.png，
                 1,026,302 个采样点、最大差值 0）⇒ 死样式，删除。
                 局限：只 A/B 了默认页，其余页未逐页比对。 -->

            <!-- 应用级主题色 -->
            <SolidColorBrush x:Key="AccentBrush" Color="#FF0078D4"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
