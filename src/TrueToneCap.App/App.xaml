<!-- TrueToneCap.App/App.xaml -->
<Application
    x:Class="TrueToneCap.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- ═══ 覆盖 WinUI 主题字体 ═══ -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <FontFamily x:Key="ContentControlThemeFontFamily">Microsoft YaHei, Segoe UI, sans-serif</FontFamily>
                    <FontFamily x:Key="TextControlThemeFontFamily">Microsoft YaHei, Segoe UI, sans-serif</FontFamily>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <FontFamily x:Key="ContentControlThemeFontFamily">Microsoft YaHei, Segoe UI, sans-serif</FontFamily>
                    <FontFamily x:Key="TextControlThemeFontFamily">Microsoft YaHei, Segoe UI, sans-serif</FontFamily>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <FontFamily x:Key="ContentControlThemeFontFamily">Microsoft YaHei, Segoe UI, sans-serif</FontFamily>
                    <FontFamily x:Key="TextControlThemeFontFamily">Microsoft YaHei, Segoe UI, sans-serif</FontFamily>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 全局默认字体隐式回退 -->
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Microsoft YaHei, Segoe UI, sans-serif" />
            </Style>
            <Style TargetType="Control">
                <Setter Property="FontFamily" Value="Microsoft YaHei, Segoe UI, sans-serif" />
            </Style>

            <!-- 这里原来有一份隐式的 FontIcon 样式，把字体族写死成某个系统符号字体族，注释写着
                 "否则图标字形无法渲染"——那句是错的：本进程按字体友好名解析符号字体本来就失败
                 （报告 §11-②），而全仓 XAML 已无任何 FontIcon 元素（图标一律 PathIcon 字形轮廓）。
                 23:11 A/B 实测：删掉它之后主窗默认页（含一枚可见的下拉箭头）逐像素零差异
                 （tests/output/realmachine-2026-10-01/mainwindow-swapped.png vs mainwindow-nostyle.png，
                 1,026,302 个采样点、最大差值 0）⇒ 死样式，删除。
                 局限：只 A/B 了默认页，其余页未逐页比对。 -->

            <!-- 应用级主题色 -->
            <SolidColorBrush x:Key="AccentBrush" Color="#FF0078D4"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
