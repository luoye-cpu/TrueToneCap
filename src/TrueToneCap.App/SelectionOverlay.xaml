<Window x:Class="TrueToneCap.App.SelectionOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SelectionOverlay"
    Closed="OnClosed">

    <!-- 关键: RootGrid 必须有无色背景才能接收指针事件 (WinUI 命中测试要求) -->
    <Grid x:Name="RootGrid" IsTabStop="True" Background="Transparent">
        <!-- HDR SwapChain 背景（HDR 显示器上直接呈现 scRGB 线性帧） -->
        <SwapChainPanel x:Name="HdrPanel" IsHitTestVisible="False" Visibility="Collapsed"/>
        <!-- SDR 桌面截图背景（回退路径） -->
        <Image x:Name="DesktopImage" Stretch="Fill" IsHitTestVisible="False"/>

        <!-- 半透明覆盖层：等待用户单击或框选 (灰色遮罩, 2026-08-11) -->
        <Border x:Name="DimOverlay" Background="#80000000" IsHitTestVisible="False"/>

        <!-- ═══════ 自动识别区域提示层 ═══════ -->
        <Canvas x:Name="RegionHintCanvas" Background="Transparent"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Visibility="Visible" IsHitTestVisible="False"/>

        <!-- 选区外遮罩 (灰色, 2026-08-11) -->
        <Grid x:Name="MaskGrid" IsHitTestVisible="False">
            <Border x:Name="MaskTop" Background="#80000000" IsHitTestVisible="False" VerticalAlignment="Top"/>
            <Border x:Name="MaskBottom" Background="#80000000" IsHitTestVisible="False" VerticalAlignment="Bottom"/>
            <Border x:Name="MaskLeft" Background="#80000000" IsHitTestVisible="False" HorizontalAlignment="Left"/>
            <Border x:Name="MaskRight" Background="#80000000" IsHitTestVisible="False" HorizontalAlignment="Right"/>
        </Grid>

        <!-- 选区四边蓝色细线（取代边框） -->
        <Rectangle x:Name="SelLineTop"    Fill="#FF4488FF" Height="1.5" Visibility="Collapsed"
                   IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Rectangle x:Name="SelLineBottom" Fill="#FF4488FF" Height="1.5" Visibility="Collapsed"
                   IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Rectangle x:Name="SelLineLeft"   Fill="#FF4488FF" Width="1.5"  Visibility="Collapsed"
                   IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Rectangle x:Name="SelLineRight"  Fill="#FF4488FF" Width="1.5"  Visibility="Collapsed"
                   IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <!-- 尺寸标签（选区上方居中） -->
        <Border x:Name="SizeLabelBorder" Background="#FF4488FF" CornerRadius="3"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Visibility="Collapsed" IsHitTestVisible="False"
                Padding="6,2">
            <TextBlock x:Name="SizeLabel" FontSize="11" Foreground="White" Text="0 x 0"/>
        </Border>

        <!-- 标注画布（进入标注模式后置于选区之上，实时显示标注） -->
        <Canvas x:Name="AnnotationCanvas" Background="Transparent"
                Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <TextBlock x:Name="HintText"
                   Text="单击 = 全屏  |  拖拽 = 框选  |  Esc = 取消"
                   FontSize="14" Foreground="#CCFFFFFF"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsHitTestVisible="False"/>

        <!-- ═══════ 主操作工具栏（选区完成后显示） ═══════ -->
        <Border x:Name="Toolbar" 
                Background="{ThemeResource CardBackgroundFillColorDefault}" CornerRadius="12" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                Padding="16,12" Visibility="Collapsed"
                HorizontalAlignment="Left" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="BtnConfirm" Width="140" Height="72"
                        Click="OnConfirm" ToolTipService.ToolTip="保存截图到文件并复制 (Enter)"
                        Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Width="32" Height="32" Data="F0 M6.18,17.36 L0,11.17 L0.9,10.28 L6.18,15.55 L19.1,2.64 L20,3.53 L6.18,17.36 Z"/>
                        <TextBlock Text="保存" FontSize="28" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnAnnotate" Width="140" Height="72"
                        Click="OnAnnotate" ToolTipService.ToolTip="标注选区（矩形/箭头/马赛克等）">
