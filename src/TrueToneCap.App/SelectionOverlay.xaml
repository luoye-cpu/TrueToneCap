                </Button>
                <Button x:Name="AnnoArrowBtn" Width="68" Height="68" Click="OnAnnoToolClick" Tag="Arrow"
                        ToolTipService.ToolTip="箭头 (A)">
                    <PathIcon Width="36" Height="36" Data="F0 M20,10 L10.78,19.22 L9.9,18.33 L17.61,10.63 L0,10.63 L0,9.37 L17.61,9.37 L9.9,1.67 L10.78,0.78 Z"/>
