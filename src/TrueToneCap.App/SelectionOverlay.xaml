                        ToolTipService.ToolTip="马赛克 (M)">
                    <PathIcon Width="36" Height="36" Data="F0 M0,0 L20,0 L20,20 L0,20 M18.46,9.23 L18.46,1.54 L10.77,1.54 L10.77,9.23 M9.23,1.54 L1.54,1.54 L1.54,9.23 L9.23,9.23 M1.54,10.77 L1.54,18.46 L9.23,18.46 L9.23,10.77 M10.77,18.46 L18.46,18.46 L18.46,10.77 L10.77,10.77 Z"/>
                </Button>
                <Rectangle Width="1" Fill="#FF888888" Margin="10,8"/>
                <Button x:Name="AnnoUndoBtn" Width="68" Height="68" Click="OnAnnoUndo"
                        ToolTipService.ToolTip="撤销 (Ctrl+Z)">
                    <PathIcon Width="36" Height="36" Data="F0 M10.65,0.05 L11.58,0.11 L12.48,0.29 L13.32,0.59 L14.12,1 L14.86,1.49 L15.52,2.08 L16.11,2.74 L16.6,3.47 L17.01,4.27 L17.31,5.12 L17.48,6.02 L17.55,6.94 L17.42,8.27 L17.03,9.55 L16.41,10.73 L15.57,11.77 L7.32,20 L6.42,19.1 L14.66,10.86 L15.35,10.03 L15.87,9.07 L16.19,8.02 L16.29,6.94 L16.17,5.83 L15.84,4.77 L15.32,3.81 L14.62,2.98 L13.79,2.28 L12.83,1.75 L11.77,1.42 L10.65,1.31 L9.65,1.39 L8.78,1.63 L8,1.99 L7.28,2.47 L5.95,3.67 L4.62,5.04 L8.76,5.04 L8.76,6.31 L2.45,6.31 L2.45,0 L3.71,0 L3.71,4.15 L4.76,3.09 L5.76,2.11 L6.77,1.27 L7.88,0.62 L9.15,0.2 L10.65,0.05"/>
                </Button>
                <Button x:Name="AnnoRedoBtn" Width="68" Height="68" Click="OnAnnoRedo"
                        ToolTipService.ToolTip="重做 (Ctrl+Y)">
                    <PathIcon Width="36" Height="36" Data="F0 M11.24,5.04 L15.38,5.04 L14.06,3.67 L12.72,2.47 L12.01,1.99 L11.22,1.63 L10.35,1.39 L9.34,1.31 L8.23,1.42 L7.18,1.75 L6.22,2.28 L5.38,2.98 L4.69,3.81 L4.16,4.77 L3.83,5.83 L3.72,6.94 L3.82,8.02 L4.14,9.07 L4.65,10.03 L5.35,10.86 L13.58,19.1 L12.69,20 L4.44,11.77 L3.59,10.73 L2.98,9.55 L2.59,8.27 L2.46,6.94 L2.52,6.02 L2.7,5.12 L3,4.27 L3.4,3.47 L3.9,2.74 L4.49,2.08 L5.15,1.49 L5.88,1 L6.68,0.59 L7.53,0.29 L8.42,0.11 L9.34,0.05 L10.86,0.2 L12.13,0.62 L13.24,1.27 L14.25,2.11 L15.25,3.09 L16.28,4.15 L16.28,0 L17.54,0 L17.54,6.31 L11.24,6.31"/>
