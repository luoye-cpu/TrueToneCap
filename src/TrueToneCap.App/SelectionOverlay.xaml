                </Button>
                <Button x:Name="AnnoTextBtn" Width="68" Height="68" Click="OnAnnoToolClick" Tag="Text"
                        ToolTipService.ToolTip="文字 (T)">
                    <PathIcon Width="36" Height="36" Data="F0 M6.91,10 L2.54,10 L1.55,12.96 L0,12.96 L3.95,1.12 L5.5,1.12 L8.59,10.4 L7.66,12.28 M6.42,8.52 L4.72,3.46 L3.03,8.52 M17.77,16.38 L18.12,17.22 L18.52,17.86 L19.1,18.24 L19.5,18.34 L20,18.37 L20,18.88 L14.82,18.88 L14.82,18.37 L15.25,18.37 L15.7,18.33 L16.04,18.14 L16.18,17.72 L16.11,17.26 L15.92,16.64 L15.68,15.95 L15.43,15.3 L15.21,14.75 L15.07,14.44 L9.9,14.44 L9.76,14.76 L9.53,15.3 L9.25,15.95 L8.98,16.63 L8.79,17.25 L8.71,17.71 L8.86,18.12 L9.22,18.3 L9.66,18.36 L10.07,18.37 L10.07,18.88 L5.72,18.88 L5.72,18.37 L6.23,18.25 L6.6,18.14 L7.1,17.75 L7.46,17.16 L7.63,16.75 L7.84,16.24 L12.37,5.56 L13.31,5.56 M14.39,12.96 L12.35,8.57 L10.4,12.96"/>
                </Button>
