<!-- TrueToneCap.App/SilentCaptureToast.xaml -->
<!-- 应用内通知浮层 —— Windows 11 通知卡片样式 -->
<!--
    2026-09-16 重做为 Windows 11 标准通知卡片布局：
      顶部行：语义图标 + 应用名 + 时间戳 + 关闭按钮
      正文区：粗体标题 + 次要色正文（可换行，最多 3 行）
    与「Windows 系统通知」的分工：
      系统通知 —— 可追溯类（无感截图完成 / 录制完成 / 失败），进通知中心；
      本浮层   —— 即时反馈类（降级提示 / OCR / 翻译），不打断、不进通知中心。
-->
<Window
    x:Class="TrueToneCap.App.SilentCaptureToast"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="TrueToneCap">

    <!-- 注：WinUI 3 的 Window 不是 FrameworkElement、**没有 Resources 属性**，
         资源字典只能挂在内容根元素（Grid）上。 -->
    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.Resources>
            <!-- 操作按钮的共用样式：三个按钮外观一致，避免逐份重复 -->
            <Style x:Key="ToastActionButton" TargetType="Button">
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>
            <!-- 2026-10-01：本文件图标全部从 FontIcon 换成 PathIcon（原因见报告 §11-②/§12：
                 这个进程按字体友好名解析符号字体失败，三族并排全画成豆腐块；Path 几何是同图里
                 已被证明可用的那条渲染路径）。PathIcon 没有 FontSize ⇒ 尺寸走 Width/Height。
                 ⚠ 轮廓只能写在 PathIcon.Data 上：WinUI 的 PathGeometry.Figures 不接受路径字符串
                 （实测 XamlCompiler WMC0055），所以四种语义图标是【预置四枚 + 切可见性】，
                 不是"共享一份 Geometry 资源"。 -->
            <Style x:Key="ToastActionIcon" TargetType="PathIcon">
                <Setter Property="Width" Value="12"/>
                <Setter Property="Height" Value="12"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Style>
            <Style x:Key="ToastActionText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Style>
        </Grid.Resources>
        <Border x:Name="ToastBorder"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                MaxWidth="480"
                PointerEntered="OnPointerEntered"
                PointerExited="OnPointerExited"
                PointerPressed="OnPointerPressed">
            <Border.RenderTransform>
                <!-- 滑入动画的起点：从右侧偏移进入，更接近 Windows 通知的观感 -->
                <TranslateTransform x:Name="SlideTransform" X="32"/>
            </Border.RenderTransform>

            <!-- 末行用 "*" 填满剩余高度：原来两行都是 Auto，内容只占约 70px，
                 卡片剩余约 46px 全空着 —— 这就是"小横幅"观感的来源。 -->
            <Grid RowDefinitions="Auto,*,Auto">
                <!-- 顶部：图标 + 应用名 + 时间 + 关闭 -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto">
                    <Grid x:Name="IconHost" Grid.Column="0" Width="14" Height="14"
                          VerticalAlignment="Center" Margin="0,0,8,0">
                        <PathIcon x:Name="IconSuccess" Visibility="Collapsed" Data="F0 M20,3.97 L6.85,17.13 L0,10.27 L1.11,9.16 L6.85,14.9 L18.89,2.87 Z"/>
                        <PathIcon x:Name="IconWarning" Visibility="Collapsed" Data="F0 M20,20 L0,20 L10,0 M2.16,18.67 L17.84,18.67 L10,2.98 M10.67,8 L10.67,14.67 L9.33,14.67 L9.33,8 M9.33,16 L10.67,16 L10.67,17.33 L9.33,17.33 Z"/>
                        <PathIcon x:Name="IconError"   Visibility="Collapsed" Data="F0 M10,0 L11.36,0.09 L12.67,0.36 L13.91,0.79 L15.05,1.36 L16.12,2.08 L17.08,2.93 L17.93,3.89 L18.65,4.96 L19.23,6.11 L19.65,7.35 L19.92,8.65 L20,10 L19.92,11.36 L19.65,12.67 L19.23,13.91 L18.65,15.05 L17.93,16.12 L17.08,17.08 L16.12,17.93 L15.05,18.65 L13.91,19.23 L12.67,19.65 L11.36,19.92 L10,20 L8.65,19.92 L7.35,19.65 L6.11,19.23 L4.96,18.65 L3.89,17.93 L2.93,17.08 L2.08,16.12 L1.36,15.05 L0.79,13.91 L0.36,12.67 L0.09,11.36 L0,10 L0.09,8.65 L0.36,7.35 L0.79,6.11 L1.36,4.96 L2.08,3.89 L2.93,2.93 L3.89,2.08 L4.96,1.36 L6.11,0.79 L7.35,0.36 L8.65,0.09 L10,0 M10,18.67 L11.17,18.6 L12.31,18.36 L13.37,17.99 L14.37,17.48 L15.29,16.87 L16.13,16.13 L16.87,15.29 L17.48,14.37 L17.99,13.37 L18.36,12.31 L18.6,11.17 L18.67,10 L18.6,8.84 L18.36,7.71 L17.99,6.64 L17.48,5.64 L16.87,4.72 L16.13,3.88 L15.29,3.15 L14.37,2.53 L13.37,2.03 L12.31,1.65 L11.17,1.41 L10,1.33 L8.84,1.41 L7.71,1.65 L6.64,2.03 L5.64,2.53 L4.72,3.15 L3.88,3.88 L3.15,4.72 L2.53,5.64 L2.03,6.64 L1.65,7.71 L1.41,8.84 L1.33,10 L1.41,11.17 L1.65,12.31 L2.03,13.37 L2.53,14.37 L3.15,15.29 L3.88,16.13 L4.72,16.87 L5.64,17.48 L6.64,17.99 L7.71,18.36 L8.84,18.6 L10,18.67 M9.33,5.33 L10.67,5.33 L10.67,12 L9.33,12 M9.33,13.33 L10.67,13.33 L10.67,14.67 L9.33,14.67"/>
                        <PathIcon x:Name="IconInfo"    Visibility="Collapsed" Data="F0 M10,20 L8.65,19.92 L7.35,19.65 L6.11,19.23 L4.96,18.65 L3.89,17.93 L2.93,17.08 L2.08,16.12 L1.36,15.05 L0.79,13.91 L0.36,12.67 L0.09,11.36 L0,10 L0.09,8.65 L0.36,7.35 L0.79,6.11 L1.36,4.96 L2.08,3.89 L2.93,2.93 L3.89,2.08 L4.96,1.36 L6.11,0.79 L7.35,0.36 L8.65,0.09 L10,0 L11.36,0.09 L12.67,0.36 L13.91,0.79 L15.05,1.36 L16.12,2.08 L17.08,2.93 L17.93,3.89 L18.65,4.96 L19.23,6.11 L19.65,7.35 L19.92,8.65 L20,10 L19.92,11.36 L19.65,12.67 L19.23,13.91 L18.65,15.05 L17.93,16.12 L17.08,17.08 L16.12,17.93 L15.05,18.65 L13.91,19.23 L12.67,19.65 L11.36,19.92 L10,20 M10,1.33 L8.84,1.41 L7.71,1.65 L6.64,2.03 L5.64,2.53 L4.72,3.15 L3.88,3.88 L3.15,4.72 L2.53,5.64 L2.03,6.64 L1.65,7.71 L1.41,8.84 L1.33,10 L1.41,11.17 L1.65,12.31 L2.03,13.37 L2.53,14.37 L3.15,15.29 L3.88,16.13 L4.72,16.87 L5.64,17.48 L6.64,17.99 L7.71,18.36 L8.84,18.6 L10,18.67 L11.17,18.6 L12.31,18.36 L13.37,17.99 L14.37,17.48 L15.29,16.87 L16.13,16.13 L16.87,15.29 L17.48,14.37 L17.99,13.37 L18.36,12.31 L18.6,11.17 L18.67,10 L18.6,8.84 L18.36,7.71 L17.99,6.64 L17.48,5.64 L16.87,4.72 L16.13,3.88 L15.29,3.15 L14.37,2.53 L13.37,2.03 L12.31,1.65 L11.17,1.41 L10,1.33 M9.33,8 L10.67,8 L10.67,14.67 L9.33,14.67 M9.33,5.33 L10.67,5.33 L10.67,6.67 L9.33,6.67"/>
                    </Grid>

                    <TextBlock Grid.Column="1"
                               Text="TrueToneCap"
                               FontSize="12"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"/>

                    <TextBlock x:Name="TimeTxt"
                               Grid.Column="2"
                               Text=""
                               FontSize="12"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>

                    <Button Grid.Column="3"
                            x:Name="CloseBtn"
                            Width="28" Height="28"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="14"
                            VerticalAlignment="Center"
                            Margin="4,0,0,0"
                            Click="OnCloseClick"
                            ToolTipService.ToolTip="关闭">
                        <PathIcon Width="10" Height="10"
                                  Data="F0 M11.42,10 L20,18.58 L18.58,20 L10,11.42 L1.42,20 L0,18.58 L8.58,10 L0,1.42 L1.42,0 L10,8.58 L18.58,0 L20,1.42 Z"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Button>
                </Grid>

                <!-- 正文：粗体标题 + 次要色正文 -->
                <StackPanel Grid.Row="1" Margin="0,6,0,0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleTxt"
                               Text=""
                               FontSize="14"
                               FontWeight="SemiBold"
                               FontFamily="Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="BodyTxt"
                               Text=""
                               FontSize="13"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               MaxLines="3"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- 操作区：仅在调用方提供了文件路径时显示。
                     注意 PointerPressed 挂在容器上 —— 冒泡事件，三个按钮的按压都会被它拦下，
                     不会传到卡片（卡片点击 = 关闭），因此按钮才点得动。 -->
                <StackPanel x:Name="ActionsPanel"
                            Grid.Row="2"
                            Orientation="Horizontal"
                            Spacing="2"
                            Margin="0,10,0,0"
                            Visibility="Collapsed"
                            PointerPressed="OnActionPointerPressed">

                    <Button x:Name="OpenFolderBtn"
                            Style="{StaticResource ToastActionButton}"
                            Click="OnOpenFolderClick"
                            ToolTipService.ToolTip="在资源管理器中打开并选中该文件">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="F0 M20,17.5 L16.25,17.5 L16.25,18.75 L12.5,18.75 L12.5,17.5 L7.5,17.5 L7.5,18.75 L3.75,18.75 L3.75,17.5 L0,17.5 L0,2.5 L0.1,2.01 L0.38,1.62 L0.76,1.35 L1.25,1.25 L5.94,1.25 L6.7,1.35 L7.26,1.58 L7.71,1.88 L8.11,2.19 L8.54,2.41 L9.06,2.5 L18.75,2.5 L19.25,2.6 L19.64,2.88 L19.91,3.26 L20,3.75 M1.25,2.5 L1.25,3.75 L5.94,3.75 L6.35,3.71 L6.68,3.59 L6.96,3.39 L7.28,3.12 L6.96,2.88 L6.68,2.68 L6.35,2.55 L5.94,2.5 M12.5,16.25 L12.5,13.75 L7.5,13.75 L7.5,16.25 M15,17.5 L15,11.88 L14.96,11.64 L14.82,11.44 L14.62,11.3 L14.38,11.25 L5.62,11.25 L5.39,11.3 L5.19,11.44 L5.05,11.64 L5,11.88 L5,17.5 L6.25,17.5 L6.25,12.5 L13.75,12.5 L13.75,17.5 M18.75,3.75 L9.06,3.75 L8.54,3.85 L8.11,4.08 L7.7,4.38 L7.26,4.69 L6.7,4.91 L5.94,5 L1.25,5 L1.25,16.25 L3.75,16.25 L3.75,11.88 L3.9,11.15 L4.3,10.55 L4.9,10.15 L5.62,10 L14.38,10 L15.11,10.15 L15.71,10.55 L16.11,11.15 L16.23,11.5 L16.25,11.88 L16.25,16.25 L18.75,16.25" Style="{StaticResource ToastActionIcon}"/>
                            <TextBlock Text="打开文件夹" Style="{StaticResource ToastActionText}"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="OpenFileBtn"
                            Style="{StaticResource ToastActionButton}"
                            Click="OnOpenFileClick"
                            ToolTipService.ToolTip="用默认程序打开该文件">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="F0 M18.48,14.97 L16.89,13.39 L16.89,20 L15.64,20 L15.64,13.39 L14.05,14.97 L13.17,14.09 L16.26,11 L19.36,14.09 M1.89,18.75 L14.39,18.75 L14.39,20 L0.64,20 L0.64,0 L11.53,0 L16.89,5.36 L16.89,10 L15.64,10 L15.64,6.25 L10.64,6.25 L10.64,1.25 L1.89,1.25 M11.89,5 L14.75,5 L11.89,2.14 Z" Style="{StaticResource ToastActionIcon}"/>
                            <TextBlock Text="打开文件" Style="{StaticResource ToastActionText}"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="CopyPathBtn"
                            Style="{StaticResource ToastActionButton}"
                            Click="OnCopyPathClick"
                            ToolTipService.ToolTip="复制文件完整路径">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="F0 M18.75,7.86 L18.75,20 L6.25,20 L6.25,16.25 L1.25,16.25 L1.25,0 L9.64,0 L13.39,3.75 L14.64,3.75 M15,7.5 L16.61,7.5 L15,5.89 M6.25,3.75 L11.61,3.75 L9.11,1.25 L2.5,1.25 L2.5,15 L6.25,15 M17.5,8.75 L13.75,8.75 L13.75,5 L7.5,5 L7.5,18.75 L17.5,18.75 Z" Style="{StaticResource ToastActionIcon}"/>
                            <TextBlock x:Name="CopyPathLabel" Text="复制路径" Style="{StaticResource ToastActionText}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
