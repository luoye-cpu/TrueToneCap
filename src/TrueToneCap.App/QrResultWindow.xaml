<Window x:Class="TrueToneCap.App.QrResultWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="TrueToneCap 二维码"
    Closed="OnClosed">

    <Grid x:Name="RootGrid" ColumnDefinitions="Auto,*">
        <!-- ═══ 左：截图区域回看（与 OcrPreviewWindow 同一款深色画布） ═══ -->
        <Border Grid.Column="0" Background="#FF1A1A2E" Width="380">
            <Image x:Name="PreviewImage" Stretch="Uniform"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- ═══ 右：载荷明文列表 ═══ -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
            <!-- 顶栏：说明 + 关闭 -->
            <Border Grid.Row="0" Padding="12,8" Background="{ThemeResource CardBackgroundFillColorDefault}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock x:Name="InfoTxt"
                               Text="解码在本机完成 · 程序不会自动打开任何内容 · 点「打开链接」才启动浏览器"
                               FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Button Grid.Column="1" Height="32" Padding="12,0" Click="OnCloseClick"
                            ToolTipService.ToolTip="关闭 (Esc)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Width="14" Height="14" Data="F0 M11.17,10 L20,18.85 L18.85,20 L10,11.17 L1.15,20 L0,18.85 L8.83,10 L0,1.15 L1.15,0 L10,8.83 L18.85,0 L20,1.15 Z"/>
                            <TextBlock Text="关闭" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,10">
                <StackPanel x:Name="PayloadList" Spacing="10"/>
            </ScrollViewer>

            <!-- 底部状态栏 -->
            <Border Grid.Row="2" Padding="14,10" Background="{ThemeResource CardBackgroundFillColorDefault}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                <TextBlock x:Name="StatusTxt" Text="" FontSize="12" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Border>
        </Grid>
    </Grid>
</Window>
