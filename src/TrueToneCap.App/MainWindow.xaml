                                <!-- 压缩强度（2026-10-07）：软件路改 avifenc 的 -s，硬件路改 NVENC 的 preset -->
                                <Grid ColumnDefinitions="120,*"><TextBlock Text="压缩强度" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="EffortAvifCbo" Grid.Column="1" SelectionChanged="OnPerFormatSelectionChanged">
                                        <ComboBoxItem Tag="Smallest">最小体积（最慢）</ComboBoxItem>
                                        <ComboBoxItem Tag="Balanced" IsSelected="True">均衡（推荐）</ComboBoxItem>
                                        <ComboBoxItem Tag="Fastest">最快</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                                <!-- ═══ 2026-10-07：这一档同时作用于两条路，但两把尺不同 ═══
                                     软件路 = avifenc 的 speed（0 最慢）+ libaom 的 tune=ssim；
                                     硬件路 = NVENC 的 preset（P1 最快）。二者【不可横向比较】。
                                     "最小体积"档在软件路上会明显变慢（实测 4K：0.3 s → 7.1 s），
                                     体积降约 24%（123.4 → 93.7 KB），必须在界面上说清代价。 -->
                                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="120,0,0,0" TextWrapping="Wrap"
                                    Text="只改变编码耗时，不影响质量设置。软件编码器（libaom）差异很大：实测 4K 下最小体积约 7.1 秒 / 93.7 KB、均衡约 0.3 秒 / 123.4 KB、最快约 0.1 秒 / 148.8 KB。最小体积档会同时启用 libaom 的 tune=ssim 以求更小。硬件编码（NVENC）三档都很快，差异小得多。"/>
