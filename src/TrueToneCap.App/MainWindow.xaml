                                <Grid ColumnDefinitions="120,*,60"><TextBlock Text="取消快捷键" VerticalAlignment="Center"/><TextBox x:Name="CancelShortcutTxt" Grid.Column="1" PlaceholderText="Esc" KeyDown="OnHotkeyRecordKeyDown"/><Button x:Name="CancelShortcutRecordBtn" Grid.Column="2" Content="录制" Click="OnCancelShortcutRecordClick" Width="54" Margin="4,0,0,0"/></Grid>
