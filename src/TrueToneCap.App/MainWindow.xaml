<Window x:Class="TrueToneCap.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="TrueToneCap" Closed="OnWindowClosed">

    <Grid RowDefinitions="*,Auto" Background="{ThemeResource SolidBackgroundFillColorBase}">
        <controls:NavigationView x:Name="MainNav" Grid.Row="0"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneToggleButtonVisible="False"
            OpenPaneLength="200"
            CompactPaneLength="48"
            SelectionChanged="OnCategoryChanged">

            <controls:NavigationView.PaneHeader>
                <StackPanel Margin="16,20,16,8">
                    <TextBlock x:Name="BrandName" Text="TrueToneCap" FontSize="20" FontWeight="Bold"/>
                    <TextBlock x:Name="BrandTagline" Text="HDR 截图工具" FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </controls:NavigationView.PaneHeader>

            <controls:NavigationView.MenuItems>
                <controls:NavigationViewItem x:Name="NavOutput" Tag="Output" Content="输出设置">
                    <controls:NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;"/></controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem x:Name="NavColor" Tag="Color" Content="色彩管理">
                    <controls:NavigationViewItem.Icon><FontIcon Glyph="&#xE790;"/></controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem x:Name="NavCapture" Tag="Capture" Content="截图设置">
                    <controls:NavigationViewItem.Icon><FontIcon Glyph="&#xE722;"/></controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem x:Name="NavAI" Tag="AI" Content="OCR / 翻译">
                    <controls:NavigationViewItem.Icon><FontIcon Glyph="&#xE945;"/></controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem x:Name="NavSystem" Tag="System" Content="系统设置">
                    <controls:NavigationViewItem.Icon><FontIcon Glyph="&#xE713;"/></controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem x:Name="NavLog" Tag="Log" Content="运行日志">
                    <controls:NavigationViewItem.Icon><FontIcon Glyph="&#xE8D4;"/></controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
            </controls:NavigationView.MenuItems>

            <ScrollViewer Padding="24,16">
                <StackPanel x:Name="ContentPanel" Spacing="16">

                    <!-- ── 输出设置 ── -->
                    <StackPanel x:Name="PageOutput" Spacing="16">
                        <TextBlock x:Name="PageOutputTitle" Text="输出设置" FontSize="20" FontWeight="Bold"/>

                        <!-- 基础输出 -->
                        <Border Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="BasicOutputTitle" Text="基础输出" FontSize="14" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="120,*"><TextBlock Text="格式" VerticalAlignment="Center"/><ComboBox x:Name="FormatCbo" Grid.Column="1" SelectionChanged="OnFormatChanged"/></Grid>
                                <TextBlock x:Name="FormatHintTxt" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="120,0,0,0" TextWrapping="Wrap"/>
                                <Grid ColumnDefinitions="120,*,50,60"><TextBlock x:Name="QualityLabel" Text="质量" VerticalAlignment="Center"/><Slider x:Name="QualitySld" Grid.Column="1" ValueChanged="OnQualityChanged"/><TextBlock x:Name="QualityLbl" Grid.Column="2" VerticalAlignment="Center" Margin="4,0,0,0"/><TextBox x:Name="QualityTxt" Grid.Column="3" VerticalAlignment="Center" Width="54" TextChanged="OnQualityTextChanged" LostFocus="OnQualityTextLostFocus"/></Grid>
                                <Grid ColumnDefinitions="120,*,50"><TextBlock Text="保存路径" VerticalAlignment="Center"/><TextBox x:Name="PathTxt" Grid.Column="1" LostFocus="OnPathLostFocus"/><Button Grid.Column="2" Content="..." Click="OnBrowsePath" Width="40" Margin="4,0,0,0"/></Grid>
                                <Grid ColumnDefinitions="120,*"><TextBlock Text="文件名前缀" VerticalAlignment="Center"/><TextBox x:Name="PrefixTxt" Grid.Column="1" LostFocus="OnPrefixLostFocus"/></Grid>
                                <CheckBox x:Name="ArchiveChk" Content="启用文件归档" Checked="OnArchiveChanged" Unchecked="OnArchiveChanged"/>
                                <Grid x:Name="ArchiveModePanel" ColumnDefinitions="120,*" Visibility="Collapsed">
                                    <TextBlock Text="归档方式" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="ArchiveModeCbo" Grid.Column="1" SelectionChanged="OnPerFormatSelectionChanged">
                                        <ComboBoxItem Tag="Year">按年 (2026)</ComboBoxItem>
                                        <ComboBoxItem Tag="Month" IsSelected="True">按月 (2026-07)</ComboBoxItem>
                                        <ComboBoxItem Tag="Day">按日 (2026-07-04)</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- AVIF 专属选项 -->
                        <Border x:Name="AvifOptionsCard" Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Visibility="Collapsed">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="AvifOptionsTitle" Text="AVIF 选项" FontSize="14" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="120,*"><TextBlock Text="编码后端" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="AvifBackendCbo" Grid.Column="1" SelectionChanged="OnAvifBackendChanged">
                                        <ComboBoxItem Tag="Auto">自动检测</ComboBoxItem><ComboBoxItem Tag="LibAom">libaom (软件)</ComboBoxItem><ComboBoxItem Tag="Qsv">Intel QSV</ComboBoxItem><ComboBoxItem Tag="Nvenc">NVIDIA NVENC</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                                <Grid ColumnDefinitions="120,*"><TextBlock Text="色度采样" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="AvifChromaCbo" Grid.Column="1" SelectionChanged="OnPerFormatSelectionChanged">
                                        <ComboBoxItem Tag="444">4:4:4 ✓ 截图推荐</ComboBoxItem><ComboBoxItem Tag="422">4:2:2</ComboBoxItem><ComboBoxItem Tag="420">4:2:0 (体积最小)</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                                <CheckBox x:Name="AvifPngSuffixChk" Content="添加 .avif.png 双后缀（兼容旧软件）" Checked="OnPerFormatChanged" Unchecked="OnPerFormatChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- AVIF 位深选项卡片 -->
                        <Border x:Name="AvifBitDepthCard" Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Visibility="Collapsed">
                            <StackPanel Spacing="12">
                                <TextBlock Text="AVIF 位深" FontSize="14" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="120,*"><TextBlock Text="位深" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="BdAvifCbo" Grid.Column="1" SelectionChanged="OnPerFormatSelectionChanged">
                                        <ComboBoxItem Tag="8">8-bit</ComboBoxItem>
                                        <ComboBoxItem Tag="10">10-bit</ComboBoxItem>
                                        <ComboBoxItem Tag="12">12-bit</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="120,0,0,0" TextWrapping="Wrap"
                                    Text="10-bit 为 HDR 最佳选择；8-bit 兼容性最广。"/>
                            </StackPanel>
                        </Border>

                        <!-- GainMap 专属选项 -->
                        <Border x:Name="GainMapOptionsCard" Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Visibility="Collapsed">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="GainMapOptionsTitle" Text="JPEG Gain Map (Ultra HDR)" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock x:Name="GainMapOptionsDesc" Text="输出兼容 JPEG 的 HDR 照片。SDR 查看器显示基础图，HDR 查看器自动还原完整动态范围。" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                <Grid ColumnDefinitions="120,*"><TextBlock x:Name="GainMapModeLabelTxt" Text="增益图模式" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="GainMapModeCbo" Grid.Column="1" SelectionChanged="OnGainMapModeChanged">
                                        <ComboBoxItem Tag="Rgb">RGB 增益（色彩准确，体积较大）</ComboBoxItem>
                                        <ComboBoxItem Tag="Gray">灰度增益（体积最优，亮度还原）</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                                <TextBlock x:Name="GainMapHintTxt" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="120,0,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- PNG 选项卡片 -->
                        <Border x:Name="PngOptionsCard" Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Visibility="Collapsed">
                            <StackPanel Spacing="12">
                                <TextBlock Text="PNG 选项" FontSize="14" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="120,*"><TextBlock Text="位深" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="BdPngCbo" Grid.Column="1" SelectionChanged="OnPerFormatSelectionChanged">
                                        <ComboBoxItem Tag="8">8-bit</ComboBoxItem>
                                        <ComboBoxItem Tag="10">10-bit (PNG 3.0)</ComboBoxItem>
                                        <ComboBoxItem Tag="12">12-bit (PNG 3.0)</ComboBoxItem>
                                        <ComboBoxItem Tag="16">16-bit</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                                <!-- PNG 色度采样：PNG 是 RGB 无损格式，不支持色度子采样 -->
                            </StackPanel>
                        </Border>

                        <!-- JPEG XL 选项卡片 -->
                        <Border x:Name="JpegXlOptionsCard" Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Visibility="Collapsed">
                            <StackPanel Spacing="12">
                                <TextBlock Text="JPEG XL 选项" FontSize="14" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="120,*"><TextBlock Text="位深" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="BdJpegXlCbo" Grid.Column="1" SelectionChanged="OnPerFormatSelectionChanged">
                                        <ComboBoxItem Tag="8">8-bit</ComboBoxItem>
                                        <ComboBoxItem Tag="10">10-bit</ComboBoxItem>
                                        <ComboBoxItem Tag="12">12-bit</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                                <Grid ColumnDefinitions="120,*"><TextBlock Text="色度采样" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="ChromaJpegXlCbo" Grid.Column="1" SelectionChanged="OnPerFormatSelectionChanged">
                                        <ComboBoxItem Tag="444">4:4:4</ComboBoxItem>
                                        <ComboBoxItem Tag="420">4:2:0</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- WebP 选项卡片 -->
                        <Border x:Name="WebPOptionsCard" Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Visibility="Collapsed">
                            <StackPanel Spacing="12">
                                <TextBlock Text="WebP 选项" FontSize="14" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="120,*"><TextBlock Text="色度采样" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="ChromaWebPCbo" Grid.Column="1" SelectionChanged="OnPerFormatSelectionChanged">
                                        <ComboBoxItem Tag="444">4:4:4</ComboBoxItem>
                                        <ComboBoxItem Tag="420">4:2:0</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <!-- TIFF 选项卡片 -->
                        <Border x:Name="TiffOptionsCard" Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Visibility="Collapsed">
                            <StackPanel Spacing="12">
                                <TextBlock Text="TIFF 选项" FontSize="14" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="120,*"><TextBlock Text="位深" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="BdTiffCbo" Grid.Column="1" SelectionChanged="OnPerFormatSelectionChanged">
                                        <ComboBoxItem Tag="8">8-bit</ComboBoxItem>
                                        <ComboBoxItem Tag="16">16-bit</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ── 色彩设置 ── -->
                    <StackPanel x:Name="PageColor" Spacing="16" Visibility="Collapsed">
                        <TextBlock x:Name="PageColorTitle" Text="色彩设置" FontSize="20" FontWeight="Bold"/>
                        <Border Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="140,*"><TextBlock Text="HDR 输出" VerticalAlignment="Center"/><ToggleSwitch x:Name="HdrSwitch" Grid.Column="1" Toggled="OnHdrToggled"/></Grid>
                                    <TextBlock x:Name="HdrHintTxt" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="140,0,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="140,*"><TextBlock Text="ICC 烘焙" VerticalAlignment="Center"/><ToggleSwitch x:Name="IccBakeSwitch" Grid.Column="1" Toggled="OnIccBakeToggled"/></Grid>
                                    <TextBlock x:Name="IccHintTxt" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="140,0,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Grid ColumnDefinitions="120,*"><TextBlock x:Name="ColorSpaceLabel" Text="目标色域" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="ColorCbo" Grid.Column="1" SelectionChanged="OnColorSpaceChanged">
                                        <ComboBoxItem Tag="System">跟随显示器（自动）</ComboBoxItem><ComboBoxItem Tag="sRGB">sRGB</ComboBoxItem><ComboBoxItem Tag="DisplayP3">Display P3</ComboBoxItem>
                                        <ComboBoxItem Tag="DCI_P3">DCI-P3</ComboBoxItem><ComboBoxItem Tag="AdobeRGB">Adobe RGB</ComboBoxItem><ComboBoxItem Tag="BT2020">BT.2020</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                                <TextBlock x:Name="IccStrategyHintTxt" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="32,0,0,0" TextWrapping="Wrap"
                                    Text="sRGB 目标不嵌入 ICC（通用默认）；非 sRGB 色域自动嵌入标准 ICC。"/>
                            </StackPanel>
                        </Border>

                        <!-- 色域映射 -->
                        <Border Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="GamutMapTitle" Text="色域映射" FontSize="14" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="120,*">
                                    <TextBlock x:Name="SourceGamutLabel" Text="显示器色域" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SourceGamutTxt" Grid.Column="1" VerticalAlignment="Center"
                                        Text="检测中..." FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                                <Grid ColumnDefinitions="120,*">
                                    <TextBlock x:Name="MappingArrow" Text="→ 映射到" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TargetGamutTxt" Grid.Column="1" VerticalAlignment="Center"
                                        Text="sRGB" FontWeight="SemiBold"/>
                                </Grid>
                                <TextBlock x:Name="GamutMapHintTxt" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="32,0,0,0" TextWrapping="Wrap"
                                    Text="ACES 影视标准 — 广色域自动感知缩限到 sRGB，确保色彩准确。"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ── 截图与录制 ── -->
                    <StackPanel x:Name="PageCapture" Spacing="16" Visibility="Collapsed">
                        <TextBlock x:Name="PageCaptureTitle" Text="截图与录制" FontSize="20" FontWeight="Bold"/>
                        <Border Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="截图" FontSize="14" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="120,*,60"><TextBlock Text="快捷键" VerticalAlignment="Center"/><TextBox x:Name="HotkeyTxt" Grid.Column="1" PlaceholderText="Ctrl+Shift+S" KeyDown="OnHotkeyRecordKeyDown"/><Button x:Name="CaptureHotkeyRecordBtn" Grid.Column="2" Content="录制" Click="OnCaptureHotkeyRecordClick" Width="54" Margin="4,0,0,0"/></Grid>
                                <Grid ColumnDefinitions="120,*,60"><TextBlock Text="无感截图快捷键" VerticalAlignment="Center"/><TextBox x:Name="SilentHotkeyTxt" Grid.Column="1" PlaceholderText="Ctrl+Shift+Q" KeyDown="OnHotkeyRecordKeyDown"/><Button x:Name="SilentHotkeyRecordBtn" Grid.Column="2" Content="录制" Click="OnSilentHotkeyRecordClick" Width="54" Margin="4,0,0,0"/></Grid>
                                <CheckBox x:Name="PreviewChk" Content="截图后右下角缩略图预览"/>
                            </StackPanel>
                        </Border>
                        <Border Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="预览界面颜色" FontSize="14" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="120,*">
                                    <TextBlock Text="覆盖遮罩颜色" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="OverlayColorCbo" Grid.Column="1" SelectionChanged="OnOverlayColorChanged">
                                        <ComboBoxItem Tag="#99001833">深蓝半透明（默认）</ComboBoxItem>
                                        <ComboBoxItem Tag="#99000000">纯黑半透明</ComboBoxItem>
                                        <ComboBoxItem Tag="#991A1A2E">深紫半透明</ComboBoxItem>
                                        <ComboBoxItem Tag="#990D1B2A">深海蓝</ComboBoxItem>
                                        <ComboBoxItem Tag="#992D2D2D">深灰半透明</ComboBoxItem>
                                        <ComboBoxItem Tag="#80FFFFFF">白色半透明</ComboBoxItem>
                                        <ComboBoxItem Tag="#99003322">深绿半透明</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                                <Grid ColumnDefinitions="120,*">
                                    <TextBlock Text="选区边框颜色" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="BorderColorCbo" Grid.Column="1" SelectionChanged="OnBorderColorChanged">
                                        <ComboBoxItem Tag="#FF4488FF">天蓝（默认）</ComboBoxItem>
                                        <ComboBoxItem Tag="#FF00FF88">翠绿</ComboBoxItem>
                                        <ComboBoxItem Tag="#FFFF6644">橙红</ComboBoxItem>
                                        <ComboBoxItem Tag="#FFFF44AA">粉红</ComboBoxItem>
                                        <ComboBoxItem Tag="#FFFFCC00">金黄</ComboBoxItem>
                                        <ComboBoxItem Tag="#FFAA66FF">紫色</ComboBoxItem>
                                        <ComboBoxItem Tag="#FFFFFFFF">纯白</ComboBoxItem>
                                        <ComboBoxItem Tag="#FF00FFCC">青色</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="动图录制" FontSize="14" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="120,*,60"><TextBlock Text="快捷键" VerticalAlignment="Center"/><TextBox x:Name="RecordHotkeyTxt" Grid.Column="1" PlaceholderText="Ctrl+Shift+G" KeyDown="OnHotkeyRecordKeyDown"/><Button x:Name="RecordBtn" Grid.Column="2" Content="录制" Click="OnRecordHotkeyClick" Width="54" Margin="4,0,0,0"/></Grid>
                                <Grid ColumnDefinitions="120,*"><TextBlock Text="格式" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="AnimFormatCbo" Grid.Column="1"><ComboBoxItem Tag="GIF">GIF</ComboBoxItem><ComboBoxItem Tag="APNG">APNG</ComboBoxItem><ComboBoxItem Tag="AVIF">动画 AVIF</ComboBoxItem></ComboBox>
                                </Grid>
                                <Grid ColumnDefinitions="120,*"><TextBlock Text="帧率" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="RecordFpsCbo" Grid.Column="1"><ComboBoxItem Tag="10">10 fps</ComboBoxItem><ComboBoxItem Tag="15" IsSelected="True">15 fps</ComboBoxItem><ComboBoxItem Tag="20">20 fps</ComboBoxItem><ComboBoxItem Tag="30">30 fps</ComboBoxItem></ComboBox>
                                </Grid>
                                <Grid ColumnDefinitions="120,*"><TextBlock Text="最大时长" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="MaxDurationCbo" Grid.Column="1"><ComboBoxItem Tag="15">15 秒</ComboBoxItem><ComboBoxItem Tag="30" IsSelected="True">30 秒</ComboBoxItem><ComboBoxItem Tag="60">60 秒</ComboBoxItem><ComboBoxItem Tag="120">120 秒</ComboBoxItem></ComboBox>
                                </Grid>
                                <Grid ColumnDefinitions="120,*"><TextBlock Text="质量" VerticalAlignment="Center"/><Slider x:Name="RecordQualitySld" Grid.Column="1" Minimum="0" Maximum="100"/></Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ── AI 翻译 ── -->
                    <StackPanel x:Name="PageAI" Spacing="16" Visibility="Collapsed">
                        <TextBlock Text="AI 翻译" FontSize="20" FontWeight="Bold"/>

                        <!-- ═══ 卡片 1: OCR 文字识别 ═══ -->
                        <Border Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8D4;" FontSize="16"/>
                                    <TextBlock Text="OCR 文字识别" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Text="截图后自动识别图中文字，支持 50+ 语言" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Grid ColumnDefinitions="100,*"><TextBlock Text="引擎" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="OcrEngineCbo" Grid.Column="1" SelectionChanged="OnOcrEngineChanged">
                                        <ComboBoxItem Tag="OnnxGpu" IsSelected="True">DirectML GPU (推荐)</ComboBoxItem>
                                        <ComboBoxItem Tag="OnnxCpu">ONNX CPU (兼容)</ComboBoxItem>
                                        <ComboBoxItem Tag="WindowsOcr">Windows OCR (系统)</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                                <Grid ColumnDefinitions="100,*"><TextBlock Text="识别语言" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="OcrLangCbo" Grid.Column="1" SelectionChanged="OnOcrLangChanged">
                                    </ComboBox>
                                </Grid>
                                <TextBlock x:Name="OcrEngineStatus" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="100,0,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- ═══ 卡片 2: 翻译模式 ═══ -->
                        <Border Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE774;" FontSize="16"/>
                                    <TextBlock Text="翻译模式" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Text="选择翻译引擎，OCR 识别后的文字将被翻译为目标语言" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Grid ColumnDefinitions="100,*"><TextBlock Text="模式" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="TranslationModeCbo" Grid.Column="1" SelectionChanged="OnTranslationModeChanged">
                                        <ComboBoxItem Tag="Free" IsSelected="True">免费翻译 (有道 / Google)</ComboBoxItem>
                                        <ComboBoxItem Tag="LLM">LLM 翻译 (OCR → AI 翻译文字)</ComboBoxItem>
                                        <ComboBoxItem Tag="Vision">视觉翻译 (图片直传 AI，实验性)</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                                <Grid ColumnDefinitions="100,*"><TextBlock Text="目标语言" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="TargetLangCbo" Grid.Column="1">
                                        <ComboBoxItem Tag="zh-CN" IsSelected="True">中文 (简体)</ComboBoxItem>
                                        <ComboBoxItem Tag="zh-TW">中文 (繁體)</ComboBoxItem>
                                        <ComboBoxItem Tag="en">English</ComboBoxItem>
                                        <ComboBoxItem Tag="ja">日本語</ComboBoxItem>
                                        <ComboBoxItem Tag="ko">한국어</ComboBoxItem>
                                        <ComboBoxItem Tag="fr">Français</ComboBoxItem>
                                        <ComboBoxItem Tag="de">Deutsch</ComboBoxItem>
                                        <ComboBoxItem Tag="es">Español</ComboBoxItem>
                                        <ComboBoxItem Tag="ru">Русский</ComboBoxItem>
                                        <ComboBoxItem Tag="pt">Português</ComboBoxItem>
                                        <ComboBoxItem Tag="it">Italiano</ComboBoxItem>
                                        <ComboBoxItem Tag="th">ไทย</ComboBoxItem>
                                        <ComboBoxItem Tag="vi">Tiếng Việt</ComboBoxItem>
                                        <ComboBoxItem Tag="ar">العربية</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                                <!-- 免费模式提示 -->
                                <TextBlock x:Name="FreeModeHint" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="自动降级：有道翻译 (国内) → Google 翻译 (海外)，无需 API Key" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- ═══ 卡片 3: LLM 配置（仅 LLM / Vision 模式可见）═══ -->
                        <Border x:Name="LlmConfigCard" Padding="16" CornerRadius="8"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                Visibility="Collapsed">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE946;" FontSize="16"/>
                                    <TextBlock Text="LLM 配置" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock x:Name="LlmModeHint" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="OCR 识别文字后，通过 LLM API 翻译为高质量译文" TextWrapping="Wrap"/>
                                <Grid ColumnDefinitions="100,*"><TextBlock Text="提供商" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="LlmProviderCbo" Grid.Column="1" SelectionChanged="OnLlmProviderChanged">
                                        <ComboBoxItem Tag="DeepSeek">DeepSeek</ComboBoxItem>
                                        <ComboBoxItem Tag="DeepSeek-Flash">DeepSeek (V4 Flash)</ComboBoxItem>
                                        <ComboBoxItem Tag="GLM">智谱 GLM</ComboBoxItem>
                                        <ComboBoxItem Tag="Gemini">Google Gemini</ComboBoxItem>
                                        <ComboBoxItem Tag="SiliconFlow">硅基流动</ComboBoxItem>
                                        <ComboBoxItem Tag="OpenAI">OpenAI</ComboBoxItem>
                                        <ComboBoxItem Tag="Aliyun">阿里云百炼</ComboBoxItem>
                                        <ComboBoxItem Tag="Moonshot">Moonshot</ComboBoxItem>
                                        <ComboBoxItem Tag="Custom" IsSelected="True">自定义</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                                <Grid ColumnDefinitions="100,*"><TextBlock Text="API 端点" VerticalAlignment="Center"/><TextBox x:Name="LlmEndpointTxt" Grid.Column="1" PlaceholderText="https://api.deepseek.com/v1"/></Grid>
                                <Grid ColumnDefinitions="100,*"><TextBlock Text="API 密钥" VerticalAlignment="Center"/><TextBox x:Name="LlmApiKeyTxt" Grid.Column="1" PlaceholderText="sk-..."/></Grid>
                                <Grid ColumnDefinitions="100,*"><TextBlock Text="模型" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="LlmModelCbo" Grid.Column="1" SelectionChanged="OnLlmModelChanged">
                                        <ComboBoxItem Tag="deepseek-chat">DeepSeek V3</ComboBoxItem>
                                        <ComboBoxItem Tag="deepseek-v4-flash">DeepSeek V4 Flash</ComboBoxItem>
                                        <ComboBoxItem Tag="glm-4.7-flash">GLM-4.7 Flash (智谱)</ComboBoxItem>
                                        <ComboBoxItem Tag="glm-4-flash">GLM-4 Flash (智谱)</ComboBoxItem>
                                        <ComboBoxItem Tag="gemini-2.0-flash">Gemini 2.0 Flash (Google)</ComboBoxItem>
                                        <ComboBoxItem Tag="gemini-2.5-flash">Gemini 2.5 Flash (Google)</ComboBoxItem>
                                        <ComboBoxItem Tag="gemini-2.5-pro">Gemini 2.5 Pro (Google)</ComboBoxItem>
                                        <ComboBoxItem Tag="Qwen/Qwen2.5-72B-Instruct">Qwen2.5-72B (硅基流动)</ComboBoxItem>
                                        <ComboBoxItem Tag="deepseek-ai/DeepSeek-V3">DeepSeek V3 (硅基流动)</ComboBoxItem>
                                        <ComboBoxItem Tag="deepseek-ai/DeepSeek-R1">DeepSeek R1 (硅基流动)</ComboBoxItem>
                                        <ComboBoxItem Tag="gpt-4o-mini">GPT-4o mini</ComboBoxItem>
                                        <ComboBoxItem Tag="gpt-4.1-mini">GPT-4.1 mini</ComboBoxItem>
                                        <ComboBoxItem Tag="gpt-4.1-nano">GPT-4.1 nano</ComboBoxItem>
                                        <ComboBoxItem Tag="qwen-turbo">Qwen Turbo (阿里)</ComboBoxItem>
                                        <ComboBoxItem Tag="qwen-plus">Qwen Plus (阿里)</ComboBoxItem>
                                        <ComboBoxItem Tag="moonshot-v1-8k">Moonshot V1 8K</ComboBoxItem>
                                        <ComboBoxItem Tag="custom">自定义模型</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                                <Grid ColumnDefinitions="100,*"><TextBlock Text="自定义模型" VerticalAlignment="Center"/><TextBox x:Name="LlmModelTxt" Grid.Column="1" PlaceholderText="deepseek-chat"/></Grid>
                                <Grid ColumnDefinitions="100,*"><TextBlock Text="提示词" VerticalAlignment="Top" Margin="0,6,0,0"/><TextBox x:Name="LlmPromptTxt" Grid.Column="1" PlaceholderText="留空使用默认翻译提示词..." AcceptsReturn="True" Height="52" TextWrapping="Wrap"/></Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ── 系统 ── -->
                    <StackPanel x:Name="PageSystem" Spacing="16" Visibility="Collapsed">
                        <TextBlock x:Name="PageSystemTitle" Text="系统" FontSize="20" FontWeight="Bold"/>
                        <Border Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="AppearanceTitle" Text="外观" FontSize="14" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="120,*"><TextBlock Text="主题" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="ThemeCbo" Grid.Column="1" SelectionChanged="OnThemeChanged">
                                        <ComboBoxItem Tag="Default" IsSelected="True">跟随系统</ComboBoxItem>
                                        <ComboBoxItem Tag="Light">浅色</ComboBoxItem>
                                        <ComboBoxItem Tag="Dark">深色</ComboBoxItem>
                                        <ComboBoxItem Tag="OLED">OLED 灰</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                                <Grid ColumnDefinitions="120,*"><TextBlock Text="语言" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="LanguageCbo" Grid.Column="1" SelectionChanged="OnLanguageChanged">
                                        <ComboBoxItem Tag="zh" IsSelected="True">中文</ComboBoxItem>
                                        <ComboBoxItem Tag="en">English</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <!-- ── 界面字体 ── -->
                        <Border Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="FontTitle" Text="界面字体" FontSize="14" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="120,*">
                                    <TextBlock x:Name="FontLabel" Text="字体" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="FontCbo" SelectionChanged="OnFontChanged">
                                        <ComboBoxItem Tag="">默认 (微软雅黑)</ComboBoxItem>
                                        <ComboBoxItem Tag="Microsoft YaHei">微软雅黑</ComboBoxItem>
                                        <ComboBoxItem Tag="Segoe UI">Segoe UI</ComboBoxItem>
                                        <ComboBoxItem Tag="Noto Sans SC">Noto Sans SC</ComboBoxItem>
                                        <ComboBoxItem Tag="Microsoft YaHei UI">Microsoft YaHei UI</ComboBoxItem>
                                        <ComboBoxItem Tag="CUSTOM">自定义...</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                                <Grid x:Name="FontCustomPanel" ColumnDefinitions="120,*" Visibility="Collapsed">
                                    <TextBlock Text="字体名称" VerticalAlignment="Center"/>
                                    <TextBox x:Name="FontCustomTxt" Grid.Column="1" PlaceholderText="输入系统已安装的字体名称" TextChanged="OnFontCustomTextChanged"/>
                                </Grid>
                                <TextBlock x:Name="FontDesc" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Text="界面字体仅影响应用外观，不影响截图像素。选择已安装的字体后需重启应用生效。"/>
                            </StackPanel>
                        </Border>
                        <Border Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="ToastTitle" Text="通知" FontSize="14" FontWeight="SemiBold"/>
                                <CheckBox x:Name="ToastCaptureChk" Content="截图后提示" IsChecked="True" Checked="OnPerFormatChanged" Unchecked="OnPerFormatChanged"/>
                                <CheckBox x:Name="ToastSilentChk" Content="无感截图后提示" IsChecked="True" Checked="OnPerFormatChanged" Unchecked="OnPerFormatChanged"/>
                                <CheckBox x:Name="ToastRecordChk" Content="录制后提示" IsChecked="True" Checked="OnPerFormatChanged" Unchecked="OnPerFormatChanged"/>
                                <Grid ColumnDefinitions="120,*">
                                    <TextBlock x:Name="ToastPositionLabel" Text="通知位置" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="ToastPositionCbo" Grid.Column="1" SelectionChanged="OnToastPositionChanged">
                                        <ComboBoxItem Tag="BottomRight" IsSelected="True">右下角</ComboBoxItem>
                                        <ComboBoxItem Tag="TopRight">右上角</ComboBoxItem>
                                        <ComboBoxItem Tag="TopLeft">左上角</ComboBoxItem>
                                        <ComboBoxItem Tag="BottomLeft">左下角</ComboBoxItem>
                                        <ComboBoxItem Tag="WindowsNotify">Windows 自带通知</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="BehaviorTitle" Text="行为" FontSize="14" FontWeight="SemiBold"/>
                                <CheckBox x:Name="AutoStartChk" Content="开机自动启动" Checked="OnPerFormatChanged" Unchecked="OnPerFormatChanged"/>
                                <CheckBox x:Name="MinimizeTrayChk" Content="关闭时最小化到托盘" IsChecked="True" Checked="OnPerFormatChanged" Unchecked="OnPerFormatChanged"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ── 运行日志 ── -->
                    <StackPanel x:Name="PageLog" Spacing="16" Visibility="Collapsed">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock x:Name="PageLogTitle" Text="运行日志" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button x:Name="LogClearBtn" Grid.Column="1" Content="清空" Click="OnLogClear" Width="64" Height="32" Margin="0,0,8,0"/>
                            <Button x:Name="LogOpenDirBtn" Grid.Column="2" Content="打开日志文件夹" Click="OnLogOpenDir" Width="120" Height="32"/>
                        </Grid>
                        <Border Padding="8" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <!-- 过滤栏 -->
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="级别:" VerticalAlignment="Center" FontSize="12"/>
                                    <ComboBox x:Name="LogFilterCbo" SelectedIndex="0" SelectionChanged="OnLogFilterChanged" Width="90">
                                        <ComboBoxItem Tag="All">全部</ComboBoxItem>
                                        <ComboBoxItem Tag="Debug">调试</ComboBoxItem>
                                        <ComboBoxItem Tag="Info">信息</ComboBoxItem>
                                        <ComboBoxItem Tag="Warning">警告</ComboBoxItem>
                                        <ComboBoxItem Tag="Error">错误</ComboBoxItem>
                                    </ComboBox>
                                    <TextBlock Text="分类:" VerticalAlignment="Center" FontSize="12"/>
                                    <ComboBox x:Name="LogCategoryCbo" SelectedIndex="0" SelectionChanged="OnLogFilterChanged" Width="90">
                                        <ComboBoxItem Tag="All">全部</ComboBoxItem>
                                        <ComboBoxItem Tag="System">⚙️ 系统</ComboBoxItem>
                                        <ComboBoxItem Tag="Capture">📷 捕获</ComboBoxItem>
                                        <ComboBoxItem Tag="Encoding">💾 编码</ComboBoxItem>
                                        <ComboBoxItem Tag="UI">🖥️ 界面</ComboBoxItem>
                                        <ComboBoxItem Tag="OCR">🔤 OCR</ComboBoxItem>
                                        <ComboBoxItem Tag="Network">🌐 网络</ComboBoxItem>
                                    </ComboBox>
                                    <TextBox x:Name="LogSearchTxt" PlaceholderText="搜索日志..." Width="180" TextChanged="OnLogSearchChanged"/>
                                </StackPanel>
                                <!-- 日志列表 -->
                                <ListView x:Name="LogListView" SelectionMode="Single"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    ScrollViewer.VerticalScrollMode="Enabled"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    Height="500">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="MinHeight" Value="24"/>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="6,3" ColumnDefinitions="Auto,Auto,Auto,Auto,*">
                                                <TextBlock Text="{Binding Icon}" FontSize="12" VerticalAlignment="Top" Margin="0,0,4,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding TimeDisplay}"
                                                    FontSize="11" Foreground="#888888" VerticalAlignment="Top" Margin="0,1,6,0" FontFamily="Consolas"/>
                                                <TextBlock Grid.Column="2" Text="{Binding CategoryIcon}" FontSize="11"
                                                    VerticalAlignment="Top" Margin="0,1,4,0"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Tag}" FontSize="11"
                                                    Foreground="#66BBFF" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,1,8,0"/>
                                                <TextBlock Grid.Column="4" Text="{Binding Message}" FontSize="12"
                                                    TextWrapping="Wrap" VerticalAlignment="Top" IsTextSelectionEnabled="True"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="LogStatusTxt" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="日志目录: 请查看 log/ 文件夹"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </controls:NavigationView>

        <!-- ═══ 底部状态栏 ═══ -->
        <Grid Grid.Row="1" Padding="16,12" Background="{ThemeResource CardBackgroundFillColorDefault}">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock x:Name="StatusTxt" Text="就绪" VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                <Button x:Name="CaptureBtn" Grid.Column="1" Content="区域截图" Click="OnCaptureBtn"
                    Width="100" Height="36" Margin="0,0,8,0" Style="{StaticResource AccentButtonStyle}"/>
                <Button Grid.Column="2" x:Name="SaveSettingsBtn" Content="保存设置" Click="OnSaveSettings" Width="100" Height="36"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
