                                <TextBlock x:Name="OcrLangHintTxt" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="100,0,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                                <TextBlock x:Name="OcrEngineStatus" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="100,0,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- ═══ 卡片 2: 翻译模式 ═══ -->
                        <Border Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE774;" FontSize="16"/>
                                    <TextBlock Text="翻译模式" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Text="选择翻译引擎，OCR 识别后的文字将被翻译为目标语言" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Grid ColumnDefinitions="100,*"><TextBlock Text="模式" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="TranslationModeCbo" Grid.Column="1" SelectionChanged="OnTranslationModeChanged">
                                        <ComboBoxItem Tag="Free" IsSelected="True">免费翻译 (有道 / Google)</ComboBoxItem>
                                        <ComboBoxItem Tag="LLM">LLM 翻译 (OCR → AI 翻译文字)</ComboBoxItem>
                                        <ComboBoxItem Tag="Vision">视觉翻译 (图片直传 AI，实验性)</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                                <Grid ColumnDefinitions="100,*"><TextBlock Text="目标语言" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="TargetLangCbo" Grid.Column="1" SelectionChanged="OnTargetLangChanged">
                                        <ComboBoxItem Tag="zh-CN" IsSelected="True">中文 (简体)</ComboBoxItem>
                                        <ComboBoxItem Tag="zh-TW">中文 (繁體)</ComboBoxItem>
                                        <ComboBoxItem Tag="en">English</ComboBoxItem>
                                        <ComboBoxItem Tag="ja">日本語</ComboBoxItem>
                                        <ComboBoxItem Tag="ko">한국어</ComboBoxItem>
                                        <ComboBoxItem Tag="fr">Français</ComboBoxItem>
                                        <ComboBoxItem Tag="de">Deutsch</ComboBoxItem>
                                        <ComboBoxItem Tag="es">Español</ComboBoxItem>
                                        <ComboBoxItem Tag="ru">Русский</ComboBoxItem>
                                        <ComboBoxItem Tag="pt">Português</ComboBoxItem>
                                        <ComboBoxItem Tag="it">Italiano</ComboBoxItem>
                                        <ComboBoxItem Tag="th">ไทย</ComboBoxItem>
                                        <ComboBoxItem Tag="vi">Tiếng Việt</ComboBoxItem>
                                        <ComboBoxItem Tag="ar">العربية</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                                <!-- 免费模式提示 + 凭据输入（仅 Free 模式可见，见 MainWindow.OcrSettings.cs） -->
                                <StackPanel x:Name="FreeModePanel" Spacing="8">
                                    <TextBlock x:Name="FreeModeHint" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="降级顺序：有道智云开放平台（需自备 AppID/密钥）→ 自定义 LLM。非官方端点（必应网页版 / Google）默认不启用。" TextWrapping="Wrap"/>
                                    <Grid ColumnDefinitions="100,*"><TextBlock Text="有道 AppID" VerticalAlignment="Center"/><TextBox x:Name="YoudaoKeyTxt" Grid.Column="1" PlaceholderText="智云开放平台 应用 ID（留空则跳过有道）"/></Grid>
                                    <Grid ColumnDefinitions="100,*"><TextBlock Text="有道密钥" VerticalAlignment="Center"/><TextBox x:Name="YoudaoSecretTxt" Grid.Column="1" PlaceholderText="AppSecret — 仅本机 DPAPI 加密存储，不写进 settings.json"/></Grid>
                                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"
                                               Text="凭据从哪来：登录 ai.youdao.com → 控制台创建应用 → 复制「应用ID / 应用密钥」。官方文档写明新用户注册即赠 50 元体验金（常见语种 48 元/百万字符 ⇒ 约 104 万字符），先扣体验金、用完才扣余额；本程序未实测到账时效与是否需要完善实名信息。"/>
                                    <CheckBox x:Name="UnofficialGoogleChk" Content="允许回退到 Google 非官方翻译端点"/>
                                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"
                                               Text="这些是各家网页前端的自用接口，不是公开 API：勾选即表示你接受截图里的文字会被发给第三方，且自行承担其服务条款风险。必应网页版免密钥、2026-09-21 国内实测能出整句译文，但它的凭据约 1 小时过期、页面一改版就断；Google 那两个端点同日实测本机连接超时。"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ═══ 卡片 3: LLM 配置（仅 LLM / Vision 模式可见）═══ -->
