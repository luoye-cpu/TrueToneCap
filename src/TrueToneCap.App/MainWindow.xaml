                                        <ComboBoxItem Tag="GLM">智谱 GLM</ComboBoxItem>
                                        <ComboBoxItem Tag="Gemini">Google Gemini</ComboBoxItem>
                                        <ComboBoxItem Tag="SiliconFlow">硅基流动</ComboBoxItem>
                                        <ComboBoxItem Tag="OpenAI">OpenAI</ComboBoxItem>
                                        <ComboBoxItem Tag="Aliyun">阿里云百炼</ComboBoxItem>
                                        <ComboBoxItem Tag="Moonshot">Moonshot</ComboBoxItem>
                                        <ComboBoxItem Tag="Custom" IsSelected="True">自定义</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                                <Grid ColumnDefinitions="100,*"><TextBlock Text="API 端点" VerticalAlignment="Center"/><TextBox x:Name="LlmEndpointTxt" Grid.Column="1" PlaceholderText="https://api.deepseek.com/v1"/></Grid>
                                <Grid ColumnDefinitions="100,*"><TextBlock Text="API 密钥" VerticalAlignment="Center"/><TextBox x:Name="LlmApiKeyTxt" Grid.Column="1" PlaceholderText="sk-..."/></Grid>
                                <Grid ColumnDefinitions="100,*"><TextBlock Text="模型" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="LlmModelCbo" Grid.Column="1" SelectionChanged="OnLlmModelChanged">
                                        <ComboBoxItem Tag="deepseek-chat">DeepSeek V3</ComboBoxItem>
                                        <ComboBoxItem Tag="deepseek-v4-flash">DeepSeek V4 Flash</ComboBoxItem>
                                        <ComboBoxItem Tag="glm-4.7-flash">GLM-4.7 Flash (智谱)</ComboBoxItem>
                                        <ComboBoxItem Tag="glm-4-flash">GLM-4 Flash (智谱)</ComboBoxItem>
                                        <ComboBoxItem Tag="gemini-2.0-flash">Gemini 2.0 Flash (Google)</ComboBoxItem>
                                        <ComboBoxItem Tag="gemini-2.5-flash">Gemini 2.5 Flash (Google)</ComboBoxItem>
                                        <ComboBoxItem Tag="gemini-2.5-pro">Gemini 2.5 Pro (Google)</ComboBoxItem>
                                        <ComboBoxItem Tag="Qwen/Qwen2.5-72B-Instruct">Qwen2.5-72B (硅基流动)</ComboBoxItem>
                                        <ComboBoxItem Tag="deepseek-ai/DeepSeek-V3">DeepSeek V3 (硅基流动)</ComboBoxItem>
                                        <ComboBoxItem Tag="deepseek-ai/DeepSeek-R1">DeepSeek R1 (硅基流动)</ComboBoxItem>
                                        <ComboBoxItem Tag="gpt-4o-mini">GPT-4o mini</ComboBoxItem>
                                        <ComboBoxItem Tag="gpt-4.1-mini">GPT-4.1 mini</ComboBoxItem>
                                        <ComboBoxItem Tag="gpt-4.1-nano">GPT-4.1 nano</ComboBoxItem>
                                        <ComboBoxItem Tag="qwen-turbo">Qwen Turbo (阿里)</ComboBoxItem>
                                        <ComboBoxItem Tag="qwen-plus">Qwen Plus (阿里)</ComboBoxItem>
                                        <ComboBoxItem Tag="moonshot-v1-8k">Moonshot V1 8K</ComboBoxItem>
                                        <ComboBoxItem Tag="custom">自定义模型</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                                <Grid ColumnDefinitions="100,*"><TextBlock Text="自定义模型" VerticalAlignment="Center"/><TextBox x:Name="LlmModelTxt" Grid.Column="1" PlaceholderText="deepseek-chat"/></Grid>
                                <Grid ColumnDefinitions="100,*"><TextBlock Text="提示词" VerticalAlignment="Top" Margin="0,6,0,0"/><TextBox x:Name="LlmPromptTxt" Grid.Column="1" PlaceholderText="留空使用默认翻译提示词..." AcceptsReturn="True" Height="52" TextWrapping="Wrap"/></Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ── 系统 ── -->
                    <StackPanel x:Name="PageSystem" Spacing="16" Visibility="Collapsed">
                        <TextBlock x:Name="PageSystemTitle" Text="系统" FontSize="20" FontWeight="Bold"/>
                        <Border Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="AppearanceTitle" Text="外观" FontSize="14" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="120,*"><TextBlock Text="主题" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="ThemeCbo" Grid.Column="1" SelectionChanged="OnThemeChanged">
                                        <ComboBoxItem Tag="Default" IsSelected="True">跟随系统</ComboBoxItem>
                                        <ComboBoxItem Tag="Light">浅色</ComboBoxItem>
                                        <ComboBoxItem Tag="Dark">深色</ComboBoxItem>
                                        <ComboBoxItem Tag="OLED">OLED 灰</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                                <Grid ColumnDefinitions="120,*"><TextBlock Text="语言" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="LanguageCbo" Grid.Column="1" SelectionChanged="OnLanguageChanged">
                                        <ComboBoxItem Tag="zh" IsSelected="True">中文</ComboBoxItem>
                                        <ComboBoxItem Tag="en">English</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <!-- ── 界面字体 ── -->
                        <Border Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="FontTitle" Text="界面字体" FontSize="14" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="120,*">
                                    <TextBlock x:Name="FontLabel" Text="字体" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="FontCbo" SelectionChanged="OnFontChanged"></ComboBox>
                                </Grid>
                                <Grid x:Name="FontCustomPanel" ColumnDefinitions="120,*" Visibility="Collapsed">
                                    <TextBlock Text="字体名称" VerticalAlignment="Center"/>
                                    <TextBox x:Name="FontCustomTxt" Grid.Column="1" PlaceholderText="输入系统已安装的字体名称" TextChanged="OnFontCustomTextChanged"/>
                                </Grid>
                                <TextBlock x:Name="FontDesc" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Text="界面字体仅影响应用外观，不影响截图像素。选择已安装的字体后需重启应用生效。"/>
                            </StackPanel>
                        </Border>
                        <Border Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="ToastTitle" Text="通知" FontSize="14" FontWeight="SemiBold"/>
                                <CheckBox x:Name="ToastCaptureChk" Content="截图后提示" IsChecked="True" Checked="OnPerFormatChanged" Unchecked="OnPerFormatChanged"/>
                                <CheckBox x:Name="ToastSilentChk" Content="无感截图后提示" IsChecked="True" Checked="OnPerFormatChanged" Unchecked="OnPerFormatChanged"/>
                                <CheckBox x:Name="ToastRecordChk" Content="录制后提示" IsChecked="True" Checked="OnPerFormatChanged" Unchecked="OnPerFormatChanged"/>
                                <Grid ColumnDefinitions="120,*">
                                    <TextBlock x:Name="ToastPositionLabel" Text="通知位置" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="ToastPositionCbo" Grid.Column="1" SelectionChanged="OnToastPositionChanged">
                                        <ComboBoxItem Tag="BottomRight" IsSelected="True">右下角</ComboBoxItem>
                                        <ComboBoxItem Tag="TopRight">右上角</ComboBoxItem>
                                        <ComboBoxItem Tag="TopLeft">左上角</ComboBoxItem>
                                        <ComboBoxItem Tag="BottomLeft">左下角</ComboBoxItem>
                                        <ComboBoxItem Tag="WindowsNotify">Windows 自带通知</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                                <!-- ═══ 2026-09-16：说明两种通知的差异 ═══
                                     二者不是一回事，选前需要知道区别：
                                       · 四角位置 = 应用内浮层（自绘窗口，不进通知中心）
                                       · Windows 自带通知 = 系统渲染、进通知中心、位置固定右下角 -->
                                <TextBlock x:Name="ToastPositionHintTxt"
                                           Text="推荐使用前四项（应用内浮层）：可控、肯定可见，且支持打开文件夹/文件/复制路径。「Windows 自带通知」依赖系统登记本应用，非打包运行时可能不显示；此时会自动回退为应用内浮层。"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="120,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="BehaviorTitle" Text="行为" FontSize="14" FontWeight="SemiBold"/>
                                <CheckBox x:Name="AutoStartChk" Content="开机自动启动" Checked="OnPerFormatChanged" Unchecked="OnPerFormatChanged"/>
                                <CheckBox x:Name="MinimizeTrayChk" Content="关闭时最小化到托盘" IsChecked="True" Checked="OnPerFormatChanged" Unchecked="OnPerFormatChanged"/>
                                <CheckBox x:Name="UiAnimationsChk" Content="启用界面过渡动画（更流畅）" IsChecked="True" Checked="OnPerFormatChanged" Unchecked="OnPerFormatChanged"/>
                                <!-- ═══ 日志详细度（2026-09-20 接线）═══
                                     CoreLog 的档位决定 Debug/Trace 进不进日志文件。
                                     档位模型早就有了，但【没有任何入口】⇒ ApplyDetailLevel 零调用方，
                                     等于恒 Brief。这里就是那个缺失的入口。
                                     ⚠ 启动最初几行仍按 Brief 落盘 —— 那会儿设置还没读进来。 -->
                                <Grid ColumnDefinitions="120,*">
                                    <TextBlock x:Name="LogVerbosityLabel" Text="日志详细度" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="LogVerbosityCbo" Grid.Column="1" SelectionChanged="OnLogVerbosityChanged">
                                        <ComboBoxItem Tag="Brief" IsSelected="True">简（默认：操作与降级）</ComboBoxItem>
                                        <ComboBoxItem Tag="Diagnose">诊断（加每拍快照/回退原因/耗时）</ComboBoxItem>
                                        <ComboBoxItem Tag="Trace">全（逐帧逐子进程，仅排障时用）</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                                <TextBlock x:Name="LogVerbosityHint" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"
                                           Text="日志写在应用目录 log/ 下按日轮转；换档只影响之后写入的行。诊断档以上量很大，排查完建议调回『简』。任何档位都不会记录截图里的文字内容、图像字节或 API 密钥。"/>
                            </StackPanel>
                        </Border>
                        <!-- ═══ 第三方许可（合规入口，2026-09-20）═══
                             BSD / Apache-2.0 一类许可证要求"再分发时必须向最终用户展示版权声明与
                             许可全文"，只写在下载页 / README 里不满足该条件 ⇒ 应用内必须有可见入口。
                             内容从磁盘读 THIRD-PARTY-NOTICES.md，渲染与降级都在 ThirdPartyNoticesWindow 里。
                             文案运行时由 ApplyLocale() 覆盖（XAML 里只是设计器兜底）。 -->
                        <Border Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="LicensesTitle" Text="第三方许可" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock x:Name="LicensesDescTxt" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Text="随本应用一并再分发的第三方组件及其许可证全文。"/>
                                <Button x:Name="OpenLicensesBtn" Content="查看第三方许可" Click="OnOpenThirdPartyNotices"
                                        HorizontalAlignment="Left" Height="36" Padding="14,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ── 运行日志 ── -->
                    <StackPanel x:Name="PageLog" Spacing="16" Visibility="Collapsed">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock x:Name="PageLogTitle" Text="运行日志" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button x:Name="LogClearBtn" Grid.Column="1" Content="清空" Click="OnLogClear" Width="64" Height="32" Margin="0,0,8,0"/>
                            <Button x:Name="LogOpenDirBtn" Grid.Column="2" Content="打开日志文件夹" Click="OnLogOpenDir" Width="120" Height="32"/>
                        </Grid>
                        <Border Padding="8" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <!-- 过滤栏 -->
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="级别:" VerticalAlignment="Center" FontSize="12"/>
                                    <ComboBox x:Name="LogFilterCbo" SelectedIndex="0" SelectionChanged="OnLogFilterChanged" Width="90">
                                        <ComboBoxItem Tag="All">全部</ComboBoxItem>
                                        <ComboBoxItem Tag="Debug">调试</ComboBoxItem>
                                        <ComboBoxItem Tag="Info">信息</ComboBoxItem>
                                        <ComboBoxItem Tag="Warning">警告</ComboBoxItem>
                                        <ComboBoxItem Tag="Error">错误</ComboBoxItem>
                                    </ComboBox>
                                    <TextBlock Text="分类:" VerticalAlignment="Center" FontSize="12"/>
                                    <ComboBox x:Name="LogCategoryCbo" SelectedIndex="0" SelectionChanged="OnLogFilterChanged" Width="90">
                                        <ComboBoxItem Tag="All">全部</ComboBoxItem>
                                        <ComboBoxItem Tag="System">⚙️ 系统</ComboBoxItem>
                                        <ComboBoxItem Tag="Capture">📷 捕获</ComboBoxItem>
                                        <ComboBoxItem Tag="Encoding">💾 编码</ComboBoxItem>
                                        <ComboBoxItem Tag="UI">🖥️ 界面</ComboBoxItem>
                                        <ComboBoxItem Tag="OCR">🔤 OCR</ComboBoxItem>
                                        <ComboBoxItem Tag="Network">🌐 网络</ComboBoxItem>
                                    </ComboBox>
                                    <TextBox x:Name="LogSearchTxt" PlaceholderText="搜索日志..." Width="160" TextChanged="OnLogSearchChanged"/>
                                    <!-- 2026-08-11: 显示顺序 + 自动滚动开关 -->
                                    <ToggleSwitch x:Name="LogNewestFirstSwitch" Header="最新在前" IsOn="True"
                                        OffContent="" OnContent="" MinWidth="90" Toggled="OnLogOrderChanged"/>
                                    <ToggleSwitch x:Name="LogAutoScrollSwitch" Header="自动滚动" IsOn="True"
                                        OffContent="" OnContent="" MinWidth="90" Toggled="OnLogAutoScrollChanged"/>
                                </StackPanel>
                                <!-- 日志列表 -->
                                <ListView x:Name="LogListView" SelectionMode="Single"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    ScrollViewer.VerticalScrollMode="Enabled"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    Height="500">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="MinHeight" Value="24"/>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="6,3" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*">
                                                <TextBlock Text="{Binding Icon}" FontSize="12" VerticalAlignment="Top" Margin="0,0,4,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding TimeDisplay}"
                                                    FontSize="11" Foreground="#888888" VerticalAlignment="Top" Margin="0,1,6,0" FontFamily="Consolas"/>
                                                <TextBlock Grid.Column="2" Text="{Binding CategoryIcon}" FontSize="11"
                                                    VerticalAlignment="Top" Margin="0,1,4,0"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Tag}" FontSize="11"
                                                    Foreground="#66BBFF" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,1,8,0"/>
                                                <TextBlock Grid.Column="4" Text="{Binding CallerDisplay}" FontSize="10"
                                                    Foreground="#55AA77" VerticalAlignment="Top" Margin="0,2,8,0" FontFamily="Consolas"/>
                                                <TextBlock Grid.Column="5" Text="{Binding Message}" FontSize="12"
                                                    TextWrapping="Wrap" VerticalAlignment="Top" IsTextSelectionEnabled="True"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="LogStatusTxt" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="日志目录: 请查看 log/ 文件夹"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </controls:NavigationView>

        <!-- ═══ 底部状态栏 ═══ -->
        <Grid Grid.Row="1" Padding="16,12" Background="{ThemeResource CardBackgroundFillColorDefault}">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock x:Name="StatusTxt" Text="就绪" VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                <Button x:Name="CaptureBtn" Grid.Column="1" Content="区域截图" Click="OnCaptureBtn"
                    Width="100" Height="36" Margin="0,0,8,0" Style="{StaticResource AccentButtonStyle}"/>
                <Button Grid.Column="2" x:Name="SaveSettingsBtn" Content="保存设置" Click="OnSaveSettings" Width="100" Height="36"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
