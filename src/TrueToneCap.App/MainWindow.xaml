                </controls:NavigationViewItem>
                <controls:NavigationViewItem x:Name="NavCapture" Tag="Capture" Content="截图设置">
                    <controls:NavigationViewItem.Icon><PathIcon Data="F0 M20,3.12 L20,18.12 L0,18.12 L0,3.12 L5.36,3.12 L6.61,1.88 L13.4,1.88 L14.65,3.12 M18.75,4.38 L14.11,4.38 L12.86,3.12 L7.15,3.12 L5.9,4.38 L1.25,4.38 L1.25,16.88 L18.75,16.88 M10,5.62 L11.01,5.72 L11.95,6.02 L12.81,6.49 L13.55,7.09 L14.15,7.82 L14.61,8.69 L14.9,9.62 L15,10.62 L14.9,11.64 L14.61,12.58 L14.15,13.44 L13.55,14.18 L12.81,14.78 L11.95,15.24 L11.01,15.52 L10,15.62 L9,15.52 L8.06,15.24 L7.2,14.78 L6.46,14.18 L5.86,13.44 L5.4,12.58 L5.1,11.64 L5,10.62 L5.1,9.62 L5.4,8.69 L5.86,7.82 L6.46,7.09 L7.2,6.49 L8.06,6.02 L9,5.72 L10,5.62 M10,14.38 L10.75,14.31 L11.46,14.09 L12.1,13.74 L12.65,13.28 L13.11,12.73 L13.46,12.09 L13.69,11.38 L13.75,10.62 L13.69,9.89 L13.46,9.18 L13.11,8.54 L12.65,7.99 L12.1,7.52 L11.46,7.18 L10.75,6.95 L10,6.88 L9.26,6.95 L8.55,7.18 L7.91,7.52 L7.36,7.99 L6.9,8.54 L6.55,9.18 L6.32,9.89 L6.25,10.62 L6.32,11.38 L6.55,12.09 L6.9,12.73 L7.36,13.28 L7.91,13.74 L8.55,14.09 L9.26,14.31 L10,14.38 M3.12,5.62 L3.38,5.68 L3.58,5.81 L3.71,6.01 L3.75,6.25 L3.71,6.5 L3.58,6.7 L3.38,6.84 L3.12,6.88 L2.89,6.84 L2.69,6.7 L2.55,6.5 L2.5,6.25 L2.55,6.01 L2.69,5.81 L2.89,5.68 L3.12,5.62"/></controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem x:Name="NavAI" Tag="AI" Content="OCR / 翻译">
                    <controls:NavigationViewItem.Icon><PathIcon Data="F0 M5.75,8.57 L9.55,20 L8.01,20 L7.05,17.14 L2.76,17.14 L1.82,20 L0.26,20 L4.08,8.57 M6.58,15.71 L4.91,10.71 L3.25,15.71 M7.48,4.64 L7.49,3.11 L7.48,1.59 L7.51,1.47 L7.65,1.44 L8.58,1.47 L9.51,1.49 L12.58,1.49 L12.58,0.74 L12.48,0 L14.01,0.07 L14.15,0.11 L14.22,0.21 L14.19,0.36 L14.14,0.49 L14.09,0.66 L14.06,0.9 L14.06,1.16 L14.06,1.33 L14.06,1.49 L17.36,1.49 L18.31,1.47 L19.24,1.44 L19.38,1.49 L19.41,1.59 L19.39,1.99 L19.38,2.39 L19.38,3.03 L19.39,3.84 L19.41,4.64 L19.41,4.73 L19.38,4.8 L19.24,4.81 L18.98,4.83 L18.55,4.83 L18.15,4.83 L17.92,4.79 L17.89,4.39 L17.89,3.8 L17.91,3.21 L17.92,2.77 L8.96,2.77 L8.96,3 L8.98,3.39 L8.98,3.84 L8.98,4.3 L8.96,4.64 L8.94,4.8 L8.79,4.83 L7.65,4.83 L7.51,4.8 L7.48,4.64 M19.71,7.53 L19.74,7.67 L19.74,8.74 L19.71,8.89 L19.56,8.9 L18.69,8.89 L17.81,8.87 L14.22,8.87 L14.22,10.21 L14.26,11.56 L14.18,12.11 L13.84,12.56 L13.41,12.73 L12.79,12.83 L12.16,12.86 L11.68,12.86 L11.46,12.86 L11.26,12.8 L11.19,12.61 L11.12,12.41 L10.94,11.87 L10.68,11.37 L11.44,11.43 L12.19,11.44 L12.59,11.36 L12.71,11.23 L12.74,10.99 L12.74,8.87 L9.18,8.87 L8.28,8.89 L7.39,8.9 L7.26,8.87 L7.24,8.74 L7.24,7.67 L7.24,7.59 L7.26,7.51 L7.39,7.5 L8.28,7.51 L9.18,7.53 L12.74,7.53 L12.71,6.94 L12.65,6.36 L13.12,6.4 L13.61,6.44 L14.35,5.86 L15.06,5.21 L11.64,5.21 L10.71,5.23 L9.76,5.26 L9.64,5.21 L9.61,5.1 L9.61,4.04 L9.64,3.9 L9.76,3.89 L10.71,3.9 L11.64,3.91 L15.79,3.91 L16.14,3.86 L16.41,3.81 L16.66,3.94 L17.01,4.26 L17.29,4.63 L17.42,4.9 L17.35,5.07 L17.19,5.17 L16.89,5.37 L16.61,5.61 L15.45,6.54 L14.22,7.4 L14.22,7.53 L17.81,7.53 L18.69,7.51 L19.56,7.5 L19.71,7.53"/></controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem x:Name="NavSystem" Tag="System" Content="系统设置">
                    <controls:NavigationViewItem.Icon><PathIcon Data="F0 M17.45,9.64 L17.46,9.82 L17.46,9.99 L17.46,10.18 L17.45,10.36 L20,11.93 L18.44,15.7 L15.52,15.02 L15.02,15.52 L15.7,18.44 L11.93,20 L10.36,17.45 L10.18,17.46 L9.99,17.46 L9.82,17.46 L9.64,17.45 L8.07,20 L4.3,18.44 L4.97,15.52 L4.48,15.02 L1.56,15.7 L0,11.93 L2.55,10.36 L2.54,10.18 L2.54,9.99 L2.54,9.82 L2.55,9.64 L0,8.07 L1.56,4.3 L4.48,4.97 L4.97,4.48 L4.3,1.56 L8.07,0 L9.64,2.55 L9.82,2.54 L9.99,2.54 L10.18,2.54 L10.36,2.55 L11.93,0 L15.7,1.56 L15.02,4.48 L15.52,4.97 L18.44,4.3 L20,8.07 M16.3,10.92 L16.34,10.46 L16.37,9.99 L16.34,9.53 L16.3,9.06 L18.62,7.62 L17.77,5.58 L15.12,6.2 L14.49,5.51 L13.8,4.88 L14.42,2.23 L12.38,1.38 L10.92,3.7 L10.46,3.66 L9.99,3.63 L9.53,3.66 L9.06,3.7 L7.62,1.38 L5.58,2.23 L6.2,4.88 L5.51,5.51 L4.88,6.2 L2.23,5.58 L1.38,7.62 L3.7,9.08 L3.66,9.54 L3.63,10.01 L3.66,10.47 L3.7,10.94 L1.38,12.38 L2.23,14.42 L4.88,13.8 L5.51,14.49 L6.2,15.12 L5.58,17.77 L7.62,18.62 L9.08,16.3 L9.54,16.34 L9.99,16.37 L10.47,16.34 L10.94,16.3 L12.38,18.62 L14.42,17.77 L13.8,15.12 L14.49,14.49 L15.12,13.8 L17.77,14.42 L18.62,12.38 M9.99,6.31 L10.74,6.39 L11.44,6.6 L12.07,6.94 L12.61,7.39 L13.06,7.93 L13.4,8.56 L13.63,9.26 L13.69,9.99 L13.63,10.74 L13.4,11.44 L13.06,12.07 L12.61,12.61 L12.07,13.06 L11.44,13.4 L10.74,13.63 L9.99,13.69 L9.26,13.63 L8.56,13.4 L7.93,13.06 L7.39,12.61 L6.94,12.07 L6.6,11.44 L6.39,10.74 L6.31,9.99 L6.39,9.26 L6.6,8.56 L6.94,7.93 L7.39,7.39 L7.93,6.94 L8.56,6.6 L9.26,6.39 L9.99,6.31 M9.99,12.6 L10.52,12.55 L11.01,12.39 L11.84,11.84 L12.39,11.01 L12.55,10.52 L12.6,9.99 L12.55,9.48 L12.39,8.99 L11.84,8.16 L11.01,7.61 L10.52,7.45 L9.99,7.4 L9.48,7.45 L8.99,7.61 L8.16,8.16 L7.61,8.99 L7.45,9.48 L7.4,9.99 L7.45,10.52 L7.61,11.01 L8.16,11.84 L8.99,12.39 L9.48,12.55 L9.99,12.6"/></controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem x:Name="NavLog" Tag="Log" Content="运行日志">
                    <controls:NavigationViewItem.Icon><PathIcon Data="F0 M20,1.88 L20,18.12 L0,18.12 L0,1.88 M1.25,3.12 L1.25,4.38 L18.75,4.38 L18.75,3.12 M18.75,16.88 L18.75,5.62 L1.25,5.62 L1.25,16.88 M13.6,8.12 L16.11,14.38 L15.23,14.38 L12.71,8.12 M7.19,8.88 L6.7,8.91 L6.25,9.04 L5.85,9.24 L5.52,9.5 L5.06,10.26 L4.94,10.75 L4.9,11.3 L5.05,12.28 L5.49,13.01 L5.81,13.29 L6.2,13.49 L6.65,13.61 L7.15,13.66 L7.84,13.59 L8.4,13.41 L8.55,14.02 L8.29,14.12 L7.94,14.21 L7,14.29 L6.4,14.24 L5.85,14.1 L5.35,13.85 L4.93,13.52 L4.58,13.1 L4.31,12.6 L4.15,12 L4.1,11.32 L4.16,10.66 L4.32,10.08 L4.6,9.54 L4.95,9.09 L5.4,8.74 L5.93,8.46 L6.51,8.3 L7.16,8.24 L7.68,8.26 L8.06,8.32 L8.36,8.41 L8.56,8.5 L8.38,9.11 L7.86,8.94 L7.19,8.88 M10,9.38 L11.25,9.38 L11.25,10.62 L10,10.62 M10,11.88 L11.25,11.88 L11.25,13.12 L10,13.12"/></controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
            </controls:NavigationView.MenuItems>

            <ScrollViewer Padding="24,16">
                <StackPanel x:Name="ContentPanel" Spacing="16">

                    <!-- ── 输出设置 ── -->
                    <StackPanel x:Name="PageOutput" Spacing="16">
                        <TextBlock x:Name="PageOutputTitle" Text="输出与色彩" FontSize="20" FontWeight="Bold"/>

                        <!-- 基础输出 -->
                        <Border Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="BasicOutputTitle" Text="基础输出" FontSize="14" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="120,*"><TextBlock Text="格式" VerticalAlignment="Center"/><ComboBox x:Name="FormatCbo" Grid.Column="1" SelectionChanged="OnFormatChanged"/></Grid>
                                <TextBlock x:Name="FormatHintTxt" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="120,0,0,0" TextWrapping="Wrap"/>
                                <Grid x:Name="QualityRow" ColumnDefinitions="120,*,54,60"><TextBlock x:Name="QualityLabel" Text="质量" VerticalAlignment="Center"/><Slider x:Name="QualitySld" Grid.Column="1" ValueChanged="OnQualityChanged"/><TextBlock x:Name="QualityLbl" Grid.Column="2" VerticalAlignment="Center" Margin="4,0,0,0" TextTrimming="None" TextWrapping="NoWrap"/><TextBox x:Name="QualityTxt" Grid.Column="3" VerticalAlignment="Center" Width="54" TextChanged="OnQualityTextChanged" LostFocus="OnQualityTextLostFocus"/></Grid>
                                <TextBlock x:Name="QualityDescTxt" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="120,0,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                                <Grid ColumnDefinitions="120,*,50"><TextBlock Text="保存路径" VerticalAlignment="Center"/><TextBox x:Name="PathTxt" Grid.Column="1" LostFocus="OnPathLostFocus"/><Button Grid.Column="2" Content="..." Click="OnBrowsePath" Width="40" Margin="4,0,0,0"/></Grid>
                                <Grid ColumnDefinitions="120,*"><TextBlock Text="文件名前缀" VerticalAlignment="Center"/><TextBox x:Name="PrefixTxt" Grid.Column="1" LostFocus="OnPrefixLostFocus"/></Grid>
                                <CheckBox x:Name="ArchiveChk" Content="启用文件归档" Checked="OnArchiveChanged" Unchecked="OnArchiveChanged"/>
                                <Grid x:Name="ArchiveModePanel" ColumnDefinitions="120,*" Visibility="Collapsed">
                                    <TextBlock Text="归档方式" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="ArchiveModeCbo" Grid.Column="1" SelectionChanged="OnPerFormatSelectionChanged">
                                        <ComboBoxItem Tag="Year">按年 (2026)</ComboBoxItem>
                                        <ComboBoxItem Tag="Month" IsSelected="True">按月 (2026-07)</ComboBoxItem>
                                        <ComboBoxItem Tag="Day">按日 (2026-07-04)</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 色彩与 HDR (原色彩管理页, 2026-08-08 合并) -->
                        <Border Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="色彩与 HDR" FontSize="14" FontWeight="SemiBold"/>
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="140,*"><TextBlock Text="HDR 输出" VerticalAlignment="Center"/><ToggleSwitch x:Name="HdrSwitch" Grid.Column="1" Toggled="OnHdrToggled"/></Grid>
                                    <TextBlock x:Name="HdrHintTxt" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="140,0,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <!-- 2026-09-22：ICC 烘焙开关已删除 —— 色彩管理不可关，默认把像素映射进
                                         标准色域（sRGB / BT.2020）。原来那个开关会带来"像素不动、容器却按
                                         请求声明"的一类产物，且它同时是 8-bit GPU 直通的闸门，留着两处语义都要解释。
                                         这行只剩一句状态说明（IccHintTxt 在下方，文案见 UpdateIccHint）。 -->
                                    <TextBlock x:Name="IccHintTxt" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Grid ColumnDefinitions="120,*"><TextBlock x:Name="ColorSpaceLabel" Text="目标色域" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="ColorCbo" Grid.Column="1" SelectionChanged="OnColorSpaceChanged">
                                        <!-- 2026-09-19 产品决定：可选目标色域只留两档（+跟随显示器）。
                                             2026-09-27 用户口径：显示名一律写成 Rec.709 / Rec.2020 ——
                                             "sRGB / BT.2020 / 非 sRGB" 这类混着叫的说法在增益图这类
                                             "底图恒 SDR" 的形态上描述不清（同一份文件里底图被叫 BT.2020、
                                             查看器读到的却是 primaries=9 + SDR 传递函数）。
                                             ⚠ Tag 保持 "sRGB"/"BT2020" 不动：Tag 是 legacyTags 迁移与
                                             SetComboByTag 的匹配键，改 Tag 等于再造一次裸索引事故。
                                             Display P3 / DCI-P3 / Adobe RGB 从界面移除，但 Core 保留其矩阵与
                                             ICC 能力（检测到的原生色域、降级声明、判据样张都还要用）。
                                             ⚠ 项序就是持久化契约：AppSettingsData.ColorSpaceIndex 存的是【索引】，
                                             这里增删或换序必须同步 MainWindow.Settings.cs 的迁移表，
                                             否则老配置的索引会静默指向另一个色域。 -->
                                        <ComboBoxItem Tag="System" IsSelected="True">跟随显示器</ComboBoxItem><ComboBoxItem Tag="sRGB">Rec.709</ComboBoxItem>
                                        <ComboBoxItem Tag="BT2020">Rec.2020</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                                <TextBlock x:Name="IccStrategyHintTxt" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="32,0,0,0" TextWrapping="Wrap"
                                    Text="目标色域同时决定像素与容器声明。"/>
                            </StackPanel>
                        </Border>

                        <!-- 色域映射 -->
                        <Border Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="GamutMapTitle" Text="色域映射" FontSize="14" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="120,*">
                                    <TextBlock x:Name="SourceGamutLabel" Text="显示器色域" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SourceGamutTxt" Grid.Column="1" VerticalAlignment="Center"
                                        Text="检测中..." FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                                <Grid ColumnDefinitions="120,*">
                                    <TextBlock x:Name="MappingArrow" Text="→ 映射到" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TargetGamutTxt" Grid.Column="1" VerticalAlignment="Center"
                                        Text="Rec.709" FontWeight="SemiBold"/>
                                </Grid>
                                <TextBlock x:Name="GamutMapHintTxt" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="32,0,0,0" TextWrapping="Wrap"
                                    Text="广色域自动缩限到目标色域。"/>
                            </StackPanel>
                        </Border>

                        <!-- AVIF 专属选项 -->
                        <Border x:Name="AvifOptionsCard" Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Visibility="Collapsed">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="AvifOptionsTitle" Text="AVIF 选项" FontSize="14" FontWeight="SemiBold"/>
                                <!-- ═══ 2026-09-16 重构：合并为单一「AVIF 编码器」下拉 ═══
                                     原「编码后端 + AVIF 编码器」两层合并为一层；
                                     能力（色度/位深/是否硬件）由 AvifEncoderCapabilities 能力表统一声明，
                                     Auto 模式硬件优先，手动选择尊重用户。 -->
                                <Grid ColumnDefinitions="120,*"><TextBlock x:Name="AvifCodecLabelTxt" Text="AVIF 编码器" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="AvifCodecCbo" Grid.Column="1" SelectionChanged="OnAvifEncoderChanged">
                                        <ComboBoxItem Tag="Auto" IsSelected="True">自动</ComboBoxItem><ComboBoxItem Tag="Qsv">Intel QSV / 系统 MFT</ComboBoxItem><ComboBoxItem Tag="LibAom">libaom</ComboBoxItem><ComboBoxItem Tag="SvtAv1">SVT-AV1</ComboBoxItem><ComboBoxItem Tag="Nvenc">NVIDIA NVENC</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                                <TextBlock x:Name="AvifCodecHintTxt" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="120,0,0,0"
                                           Text="自动优先硬件编码器；色度或位深不满足时自动降级并提示。"/>
                                <!-- ═══ 2026-09-18（用户指令）：移除「硬件编码」复选框 ═══
                                     编码器下拉已能显式选择硬件（NVENC/QSV），复选框与之语义重复。
                                     硬件总闸恒开（含崩溃哨兵自动降级保护，保留在 Core 层）。 -->
                                <Grid ColumnDefinitions="120,*"><TextBlock Text="色度采样" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="AvifChromaCbo" Grid.Column="1" SelectionChanged="OnPerFormatSelectionChanged">
                                        <ComboBoxItem Tag="420" IsSelected="True">4:2:0</ComboBoxItem><ComboBoxItem Tag="422">4:2:2</ComboBoxItem><ComboBoxItem Tag="444">4:4:4</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                                <CheckBox x:Name="AvifPngSuffixChk" Content="额外添加 .png 后缀来提高兼容性" Checked="OnPerFormatChanged" Unchecked="OnPerFormatChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- AVIF 位深选项卡片 -->
                        <Border x:Name="AvifBitDepthCard" Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Visibility="Collapsed">
                            <StackPanel Spacing="12">
                                <TextBlock Text="AVIF 位深" FontSize="14" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="120,*"><TextBlock Text="位深" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="BdAvifCbo" Grid.Column="1" SelectionChanged="OnPerFormatSelectionChanged">
                                        <ComboBoxItem Tag="8">8-bit</ComboBoxItem>
                                        <ComboBoxItem Tag="10" IsSelected="True">10-bit</ComboBoxItem>
                                        <ComboBoxItem Tag="12">12-bit</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
