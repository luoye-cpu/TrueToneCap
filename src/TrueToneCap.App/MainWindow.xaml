<Window x:Class="TrueToneCap.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="TrueToneCap" Closed="OnWindowClosed">

    <Grid RowDefinitions="*,Auto" Background="{ThemeResource SolidBackgroundFillColorBase}">
        <controls:NavigationView x:Name="MainNav" Grid.Row="0"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneToggleButtonVisible="False"
            OpenPaneLength="200"
            CompactPaneLength="48"
            SelectionChanged="OnCategoryChanged">

            <controls:NavigationView.PaneHeader>
                <StackPanel Margin="16,20,16,8">
                    <TextBlock x:Name="BrandName" Text="TrueToneCap" FontSize="20" FontWeight="Bold"/>
                    <TextBlock x:Name="BrandTagline" Text="HDR 截图工具" FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </controls:NavigationView.PaneHeader>

            <controls:NavigationView.MenuItems>
                <controls:NavigationViewItem x:Name="NavOutput" Tag="Output" Content="输出设置">
                    <controls:NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;"/></controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem x:Name="NavCapture" Tag="Capture" Content="截图设置">
                    <controls:NavigationViewItem.Icon><FontIcon Glyph="&#xE722;"/></controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem x:Name="NavAI" Tag="AI" Content="OCR / 翻译">
                    <controls:NavigationViewItem.Icon><FontIcon Glyph="&#xE945;"/></controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem x:Name="NavSystem" Tag="System" Content="系统设置">
                    <controls:NavigationViewItem.Icon><FontIcon Glyph="&#xE713;"/></controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItem x:Name="NavLog" Tag="Log" Content="运行日志">
                    <controls:NavigationViewItem.Icon><FontIcon Glyph="&#xE8D4;"/></controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
            </controls:NavigationView.MenuItems>

            <ScrollViewer Padding="24,16">
                <StackPanel x:Name="ContentPanel" Spacing="16">

                    <!-- ── 输出设置 ── -->
                    <StackPanel x:Name="PageOutput" Spacing="16">
                        <TextBlock x:Name="PageOutputTitle" Text="输出与色彩" FontSize="20" FontWeight="Bold"/>

                        <!-- 基础输出 -->
                        <Border Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="BasicOutputTitle" Text="基础输出" FontSize="14" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="120,*"><TextBlock Text="格式" VerticalAlignment="Center"/><ComboBox x:Name="FormatCbo" Grid.Column="1" SelectionChanged="OnFormatChanged"/></Grid>
                                <TextBlock x:Name="FormatHintTxt" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="120,0,0,0" TextWrapping="Wrap"/>
                                <Grid ColumnDefinitions="120,*,54,60"><TextBlock x:Name="QualityLabel" Text="质量" VerticalAlignment="Center"/><Slider x:Name="QualitySld" Grid.Column="1" ValueChanged="OnQualityChanged"/><TextBlock x:Name="QualityLbl" Grid.Column="2" VerticalAlignment="Center" Margin="4,0,0,0" TextTrimming="None" TextWrapping="NoWrap"/><TextBox x:Name="QualityTxt" Grid.Column="3" VerticalAlignment="Center" Width="54" TextChanged="OnQualityTextChanged" LostFocus="OnQualityTextLostFocus"/></Grid>
                                <TextBlock x:Name="QualityDescTxt" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="120,0,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                                <Grid ColumnDefinitions="120,*,50"><TextBlock Text="保存路径" VerticalAlignment="Center"/><TextBox x:Name="PathTxt" Grid.Column="1" LostFocus="OnPathLostFocus"/><Button Grid.Column="2" Content="..." Click="OnBrowsePath" Width="40" Margin="4,0,0,0"/></Grid>
                                <Grid ColumnDefinitions="120,*"><TextBlock Text="文件名前缀" VerticalAlignment="Center"/><TextBox x:Name="PrefixTxt" Grid.Column="1" LostFocus="OnPrefixLostFocus"/></Grid>
                                <CheckBox x:Name="ArchiveChk" Content="启用文件归档" Checked="OnArchiveChanged" Unchecked="OnArchiveChanged"/>
                                <Grid x:Name="ArchiveModePanel" ColumnDefinitions="120,*" Visibility="Collapsed">
                                    <TextBlock Text="归档方式" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="ArchiveModeCbo" Grid.Column="1" SelectionChanged="OnPerFormatSelectionChanged">
                                        <ComboBoxItem Tag="Year">按年 (2026)</ComboBoxItem>
                                        <ComboBoxItem Tag="Month" IsSelected="True">按月 (2026-07)</ComboBoxItem>
                                        <ComboBoxItem Tag="Day">按日 (2026-07-04)</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 色彩与 HDR (原色彩管理页, 2026-08-08 合并) -->
                        <Border Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="色彩与 HDR" FontSize="14" FontWeight="SemiBold"/>
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="140,*"><TextBlock Text="HDR 输出" VerticalAlignment="Center"/><ToggleSwitch x:Name="HdrSwitch" Grid.Column="1" Toggled="OnHdrToggled"/></Grid>
                                    <TextBlock x:Name="HdrHintTxt" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="140,0,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <!-- 2026-09-22：ICC 烘焙开关已删除 —— 色彩管理不可关，默认把像素映射进
                                         标准色域（sRGB / BT.2020）。原来那个开关会带来"像素不动、容器却按
                                         请求声明"的一类产物，且它同时是 8-bit GPU 直通的闸门，留着两处语义都要解释。
                                         这行只剩一句状态说明（IccHintTxt 在下方，文案见 UpdateIccHint）。 -->
                                    <TextBlock x:Name="IccHintTxt" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Grid ColumnDefinitions="120,*"><TextBlock x:Name="ColorSpaceLabel" Text="目标色域" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="ColorCbo" Grid.Column="1" SelectionChanged="OnColorSpaceChanged">
                                        <!-- 2026-09-19 产品决定：可选目标色域只留 sRGB / BT.2020（+跟随显示器）。
                                             Display P3 / DCI-P3 / Adobe RGB 从界面移除，但 Core 保留其矩阵与 ICC 能力
                                             （检测到的原生色域、烘焙失败时的降级声明、判据样张都还要用）。
                                             ⚠ 项序就是持久化契约：AppSettingsData.ColorSpaceIndex 存的是【索引】，
                                             这里增删或换序必须同步 MainWindow.Settings.cs 的迁移表，
                                             否则老配置的索引会静默指向另一个色域。 -->
                                        <ComboBoxItem Tag="System" IsSelected="True">跟随显示器（自动）</ComboBoxItem><ComboBoxItem Tag="sRGB">sRGB</ComboBoxItem>
                                        <ComboBoxItem Tag="BT2020">BT.2020</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                                <TextBlock x:Name="IccStrategyHintTxt" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="32,0,0,0" TextWrapping="Wrap"
                                    Text="sRGB 目标不嵌入 ICC（通用默认）；非 sRGB 色域自动嵌入标准 ICC。"/>
                            </StackPanel>
                        </Border>

                        <!-- 色域映射 -->
                        <Border Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="GamutMapTitle" Text="色域映射" FontSize="14" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="120,*">
                                    <TextBlock x:Name="SourceGamutLabel" Text="显示器色域" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SourceGamutTxt" Grid.Column="1" VerticalAlignment="Center"
                                        Text="检测中..." FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                                <Grid ColumnDefinitions="120,*">
                                    <TextBlock x:Name="MappingArrow" Text="→ 映射到" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TargetGamutTxt" Grid.Column="1" VerticalAlignment="Center"
                                        Text="sRGB" FontWeight="SemiBold"/>
                                </Grid>
                                <TextBlock x:Name="GamutMapHintTxt" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="32,0,0,0" TextWrapping="Wrap"
                                    Text="分段 Reinhard — 广色域自动感知缩限到目标色域，确保色彩准确。"/>
                            </StackPanel>
                        </Border>

                        <!-- AVIF 专属选项 -->
                        <Border x:Name="AvifOptionsCard" Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Visibility="Collapsed">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="AvifOptionsTitle" Text="AVIF 选项" FontSize="14" FontWeight="SemiBold"/>
                                <!-- ═══ 2026-09-16 重构：合并为单一「AVIF 编码器」下拉 ═══
                                     原「编码后端 + AVIF 编码器」两层合并为一层；
                                     能力（色度/位深/是否硬件）由 AvifEncoderCapabilities 能力表统一声明，
                                     Auto 模式硬件优先，手动选择尊重用户。 -->
                                <Grid ColumnDefinitions="120,*"><TextBlock x:Name="AvifCodecLabelTxt" Text="AVIF 编码器" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="AvifCodecCbo" Grid.Column="1" SelectionChanged="OnAvifEncoderChanged">
                                        <ComboBoxItem Tag="Auto" IsSelected="True">自动（硬件优先）</ComboBoxItem><ComboBoxItem Tag="Qsv">Intel QSV / 系统 MFT（硬件）</ComboBoxItem><ComboBoxItem Tag="LibAom">libaom（软件 · 兼容优先）</ComboBoxItem><ComboBoxItem Tag="SvtAv1">SVT-AV1（软件 · 速度优先）</ComboBoxItem><ComboBoxItem Tag="Avifenc">avifenc（软件 · 自选编码器）</ComboBoxItem><ComboBoxItem Tag="Nvenc">NVIDIA NVENC（硬件）</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                                <TextBlock x:Name="AvifCodecHintTxt" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="120,0,0,0"
                                           Text="自动模式优先使用实测可用的硬件加速；硬件编码器受色度/位深限制，不满足时会自动降级并提示。"/>
                                <!-- ═══ 2026-09-18（用户指令）：移除「硬件编码」复选框 ═══
                                     编码器下拉已能显式选择硬件（NVENC/QSV），复选框与之语义重复。
                                     硬件总闸恒开（含崩溃哨兵自动降级保护，保留在 Core 层）。 -->
                                <Grid ColumnDefinitions="120,*"><TextBlock Text="色度采样" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="AvifChromaCbo" Grid.Column="1" SelectionChanged="OnPerFormatSelectionChanged">
                                        <ComboBoxItem Tag="420" IsSelected="True">4:2:0（默认 · Auto 可走硬件加速）</ComboBoxItem><ComboBoxItem Tag="422">4:2:2（仅软件编码器）</ComboBoxItem><ComboBoxItem Tag="444">4:4:4（色度不压缩 · 仅软件编码器，较慢）</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                                <CheckBox x:Name="AvifPngSuffixChk" Content="额外添加 .png 后缀来提高兼容性" Checked="OnPerFormatChanged" Unchecked="OnPerFormatChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- AVIF 位深选项卡片 -->
                        <Border x:Name="AvifBitDepthCard" Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Visibility="Collapsed">
                            <StackPanel Spacing="12">
                                <TextBlock Text="AVIF 位深" FontSize="14" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="120,*"><TextBlock Text="位深" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="BdAvifCbo" Grid.Column="1" SelectionChanged="OnPerFormatSelectionChanged">
                                        <ComboBoxItem Tag="8">8-bit</ComboBoxItem>
                                        <ComboBoxItem Tag="10" IsSelected="True">10-bit</ComboBoxItem>
                                        <ComboBoxItem Tag="12">12-bit（仅软件编码器）</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                                <!-- ═══ 2026-09-18：位深按编码器实际能力生效，不支持的组合会被隐藏 ═══
                                     软件 ≤12-bit（avifenc 的 depth 参数）／NVENC ≤10-bit（真 10-bit 输入）／QSV 8-bit；
                                     HDR 恒 10-bit。>8-bit 是否"真"取决于源：只有 Float16 采集
                                     且编码器支持真 10-bit 输入时才保留源精度，否则是容器级升位深。 -->
                                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="120,0,0,0" TextWrapping="Wrap"
                                    Text="位深按所选编码器能力生效（软件 ≤12-bit、NVENC ≤10-bit、QSV 8-bit），不支持的档位已隐藏；HDR 输出恒 10-bit。8-bit 兼容性最广；>8-bit 仅在源为 Float16（HDR/高级颜色采集）时保留真精度，普通 8-bit 截图恒输出 8-bit。"/>
                            </StackPanel>
                        </Border>

                        <!-- GainMap 专属选项 -->
                        <Border x:Name="GainMapOptionsCard" Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Visibility="Collapsed">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="GainMapOptionsTitle" Text="JPEG Gain Map (Ultra HDR)" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock x:Name="GainMapOptionsDesc" Text="输出兼容 JPEG 的 HDR 照片。SDR 查看器显示基础图，HDR 查看器自动还原完整动态范围。" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                <Grid ColumnDefinitions="120,*"><TextBlock x:Name="GainMapModeLabelTxt" Text="增益图模式" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="GainMapModeCbo" Grid.Column="1" SelectionChanged="OnGainMapModeChanged">
                                        <ComboBoxItem Tag="Rgb">RGB 增益（色彩准确，体积较大）</ComboBoxItem>
                                        <ComboBoxItem Tag="Gray" IsSelected="True">灰度增益（体积最优，亮度还原）</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                                <!-- ═══ 2026-09-19（用户决定）：GainMap 色度成为真设置，默认 4:2:0、最高可选 4:4:4 ═══
                                     此前主路径把 base 硬编码成 4:4:4、只有降级旁路读设置 ⇒ 界面上没有这个下拉时
                                     字段是假配置（交接 §27）。现在两条路径同源，故补上下拉。 -->
                                <Grid ColumnDefinitions="120,*"><TextBlock x:Name="GainMapChromaLabelTxt" Text="色度采样" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="GainMapChromaCbo" Grid.Column="1" SelectionChanged="OnPerFormatSelectionChanged">
                                        <ComboBoxItem Tag="420" IsSelected="True">4:2:0（默认 · 兼容性最好）</ComboBoxItem>
                                        <ComboBoxItem Tag="422">4:2:2</ComboBoxItem>
                                        <ComboBoxItem Tag="444">4:4:4（色度不压缩，体积更大）</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                                <TextBlock x:Name="GainMapHintTxt" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="120,0,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- PNG 选项卡片 -->
                        <Border x:Name="PngOptionsCard" Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Visibility="Collapsed">
                            <StackPanel Spacing="12">
                                <TextBlock Text="PNG 选项" FontSize="14" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="120,*"><TextBlock Text="位深" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="BdPngCbo" Grid.Column="1" SelectionChanged="OnPerFormatSelectionChanged">
                                        <ComboBoxItem Tag="8" IsSelected="True">8-bit</ComboBoxItem>
                                        <ComboBoxItem Tag="10">10-bit (PNG 3.0)</ComboBoxItem>
                                        <ComboBoxItem Tag="12">12-bit (PNG 3.0)</ComboBoxItem>
                                        <ComboBoxItem Tag="16">16-bit</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                                <!-- ═══ 2026-09-19：只补说明，不改编码行为（§4.3 双路径策略）═══
                                     位深下拉留在那里是真会生效的（PNG 走 10/12/16-bit 容器 + HDR 路径真量化），
                                     但用户容易以为"选 16-bit 就得到 16-bit 截图"——8-bit 源升上去不产生信息，
                                     这句话必须写在界面上，而不是藏在文档里。 -->
                                <TextBlock x:Name="BdPngNoteTxt" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="120,0,0,0" TextWrapping="Wrap"
                                    Text="8-bit 截图源不会升位深（升位深不产生信息）；高位深仅对 Float16/HDR 源有意义。"/>
                                <!-- PNG 色度采样：PNG 是 RGB 无损格式，不支持色度子采样 -->
                            </StackPanel>
                        </Border>

                        <!-- JPEG LI 选项卡片 -->
                        <Border x:Name="JpegLiOptionsCard" Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Visibility="Collapsed">
                            <StackPanel Spacing="12">
                                <TextBlock Text="JPEG LI 选项" FontSize="14" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="120,*"><TextBlock Text="色度采样" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="ChromaJpegLiCbo" Grid.Column="1" SelectionChanged="OnPerFormatSelectionChanged">
                                        <ComboBoxItem Tag="444">4:4:4（最佳质量）</ComboBoxItem>
                                        <ComboBoxItem Tag="422">4:2:2（平衡）</ComboBoxItem>
                                        <ComboBoxItem Tag="420" IsSelected="True">4:2:0（最小体积）</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- JPEG XL 选项卡片 -->
                        <Border x:Name="JpegXlOptionsCard" Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Visibility="Collapsed">
                            <StackPanel Spacing="12">
                                <TextBlock Text="JPEG XL 选项" FontSize="14" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="120,*"><TextBlock Text="位深" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="BdJpegXlCbo" Grid.Column="1" SelectionChanged="OnPerFormatSelectionChanged">
                                        <ComboBoxItem Tag="8">8-bit</ComboBoxItem>
                                        <ComboBoxItem Tag="10" IsSelected="True">10-bit（16-bit 容器）</ComboBoxItem>
                                        <ComboBoxItem Tag="16">16-bit（Float16 源真精度）</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                                <!-- 2026-09-17：原 12-bit 选项已移除。cjxl 没有 -b 参数，
                                     位深由输入容器决定 ⇒ 10 与 12 的产物完全相同（16-bit 容器），
                                     留着只会让用户以为"选了更高位深"而实际毫无区别。
                                     2026-09-18：新增 16-bit 档 —— Encode16Bgra16 走 16-bit PNG
                                     中转（sBIT=16），Float16 源（≈11-bit 有效精度）几乎无损。 -->
                                <!-- ═══ 2026-09-19：只补说明，不改编码行为（§4.3 双路径策略）═══
                                     JXL 的 8 / 10 / 16 三档产物确实互不相同，但"16-bit"对 8-bit 截图源
                                     只是容器精度、不产生新信息 —— 这一点必须写在界面上而不是文档里。 -->
                                <TextBlock x:Name="BdJpegXlNoteTxt" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="120,0,0,0" TextWrapping="Wrap"
                                    Text="8-bit 截图源不会升位深（升位深不产生信息）；高位深仅对 Float16/HDR 源有意义。"/>
                                <Grid ColumnDefinitions="120,*"><TextBlock Text="色度采样" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="ChromaJpegXlCbo" Grid.Column="1" SelectionChanged="OnPerFormatSelectionChanged">
                                        <ComboBoxItem Tag="444" IsSelected="True">4:4:4</ComboBoxItem>
                                        <ComboBoxItem Tag="420">4:2:0</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                                <CheckBox x:Name="JxlPngSuffixChk" Content="额外添加 .png 后缀来提高兼容性" Checked="OnPerFormatChanged" Unchecked="OnPerFormatChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- WebP 选项卡片 -->
                        <Border x:Name="WebPOptionsCard" Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Visibility="Collapsed">
                            <StackPanel Spacing="12">
                                <TextBlock Text="WebP 选项" FontSize="14" FontWeight="SemiBold"/>
                                <!-- ═══ 2026-09-19（实测确认）：原「色度采样」下拉已撤掉，改为一行静态说明 ═══
                                     实测：同一样张只改色度，420 与 444 的产物字节完全相同，ffprobe 恒报 yuv420p。
                                     根因不是"接线漏了"而是"接不上"：NativeWebPEncoder 调 cwebp 时只传 -q / -lossless，
                                     没有任何色度形参；而有损 WebP 的格式定义就是 4:2:0（无损为 RGB）。
                                     留一个选了也不改变任何东西的下拉 = 界面撒谎，所以撤控件、把事实写在这里。 -->
                                <TextBlock x:Name="WebPChromaNoteTxt" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                    Text="有损 WebP 恒 4:2:0（格式定义）；无损为 RGB。本格式无色度可选，也没有对应设置项。"/>
                            </StackPanel>
                        </Border>
                        <!-- TIFF 选项卡片 -->
                        <Border x:Name="TiffOptionsCard" Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Visibility="Collapsed">
                            <StackPanel Spacing="12">
                                <TextBlock Text="TIFF 选项" FontSize="14" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="120,*"><TextBlock Text="位深" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="BdTiffCbo" Grid.Column="1" SelectionChanged="OnPerFormatSelectionChanged">
                                        <ComboBoxItem Tag="8" IsSelected="True">8-bit</ComboBoxItem>
                                        <ComboBoxItem Tag="16">16-bit</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                                <!-- ═══ 2026-09-19：只补说明，不改编码行为（§4.3 双路径策略）═══
                                     TIFF 的 BitsPerSample 只有 8/16 合法（写 10/12 会产出打不开的文件，
                                     已在 ManagedTiffEncoder 入口兜底）；而 16-bit 对 8-bit 源只是把每个
                                     采样铺到 16 位，像素信息一条没多 —— 这行说明就是补这个认知差。 -->
                                <TextBlock x:Name="BdTiffNoteTxt" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="120,0,0,0" TextWrapping="Wrap"
                                    Text="8-bit 截图源不会升位深（升位深不产生信息）；高位深仅对 Float16/HDR 源有意义。"/>
