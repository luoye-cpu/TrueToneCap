                        <!-- JPEG LI 选项卡片（2026-09-26：GainMap 并入，成为这里的一个开关） -->
                        <Border x:Name="JpegLiOptionsCard" Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Visibility="Collapsed">
                            <StackPanel Spacing="12">
                                <TextBlock Text="JPEG 选项" FontSize="14" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="120,*"><TextBlock Text="色度采样" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="ChromaJpegLiCbo" Grid.Column="1" SelectionChanged="OnPerFormatSelectionChanged">
                                        <ComboBoxItem Tag="444">4:4:4</ComboBoxItem>
                                        <ComboBoxItem Tag="422">4:2:2</ComboBoxItem>
                                        <ComboBoxItem Tag="420" IsSelected="True">4:2:0</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                                <TextBlock x:Name="ChromaJpegLiNoteTxt" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="120,0,0,0" TextWrapping="Wrap"
                                    Text="采样越高色度越准、体积越大：4:4:4 不压缩色度，4:2:0 体积最小（截图里的文字边缘最容易看出差别）。增益图开与不开共用这一项。"/>
                                <!-- 压缩强度（2026-10-07）：改 cjpegli 的 xyb 开关（色彩空间） -->
                                <Grid ColumnDefinitions="120,*"><TextBlock Text="压缩强度" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="EffortJpegLiCbo" Grid.Column="1" SelectionChanged="OnPerFormatSelectionChanged">
                                        <ComboBoxItem Tag="Smallest">最小体积（最慢）</ComboBoxItem>
                                        <ComboBoxItem Tag="Balanced" IsSelected="True">均衡（推荐）</ComboBoxItem>
                                        <ComboBoxItem Tag="Fastest">最快</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                                <!-- ═══ 2026-10-07：为什么 JPEG LI 也加这一栏（与"只有三个格式加"的初版口径不同）═══
                                     初版把 JPEG LI 排除在外，理由写的是"它的压缩强度与质量是同一个旋钮"。
                                     但 xyb 开关换的是**色彩空间**、不是质量，且实测在两张真实截图 ×
                                     -d 0.5/1.0/2.0/3.0 以及 GainMap 的 Baseline 路上**一律更小**
                                     （1.5%~4.7%，无一例外）—— 是本仓所有编码器小参里唯一
                                     "在所有测过的内容与质量上都为正"的开关。用户据实测要求纳入 ⇒ 加。
                                     代价只有时间，正是这一栏管的轴。 -->
                                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="120,0,0,0" TextWrapping="Wrap"
                                    Text="只改变编码耗时，不影响质量设置。实测 4K 截图：最小体积档约 0.16~0.28 秒、均衡约 0.10~0.17 秒；最小体积档体积小约 2%~5%（它改用 XYB 色彩空间，同样的观感质量下码率更低）。最快档与均衡档的产物相同（本格式没有更快的档位可用）。"/>
                                <!-- ═══ 增益图开关 ═══
                                     2026-09-26（用户口径）：GainMap 不再是输出格式下拉里的一项，
                                     而是"JPEG LI 的另一个形态"。打开后编码走 JPEG_GAINMAP 那条路，
                                     且 HDR 锁定开启（关掉就没有增益图，这个形态本身不成立）。
                                     色度刻意【不另设下拉】—— 它就是这个卡片上面那一条 ChromaJpegLiCbo，
                                     两处各设一个下拉去写同一个字段，就是刚被合并掉的那种分裂。 -->
                                <CheckBox x:Name="GainMapEnableChk" Content="附带增益图（输出 Ultra HDR 照片）"
                                          Checked="OnGainMapToggled" Unchecked="OnGainMapToggled"/>
                                <TextBlock x:Name="GainMapOptionsDesc" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                    Text="底图恒为 SDR —— 这是 Ultra HDR 的结构，HDR 在增益图里，不在底图的声明里。上面「目标色域」决定底图与增益图共用哪套原色：Rec.709（默认）或 Rec.2020（只有亲手选才会，「跟随显示器」解析成广色域不触发）。这条口径不只管增益图：JPEG 与 WebP 两族格式的默认目标同样是 Rec.709，只有你亲手选 Rec.2020 才产出 Rec.2020。打开此开关时 HDR 输出锁定为开。"/>
                                <Grid x:Name="GainMapModeRow" ColumnDefinitions="120,*">
                                    <TextBlock x:Name="GainMapModeLabelTxt" Text="增益图模式" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="GainMapModeCbo" Grid.Column="1" SelectionChanged="OnGainMapModeChanged">
                                        <ComboBoxItem Tag="Rgb">RGB 增益</ComboBoxItem>
                                        <ComboBoxItem Tag="Gray" IsSelected="True">灰度增益</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                                <TextBlock x:Name="GainMapHintTxt" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="120,0,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- PNG 选项卡片 -->
                        <Border x:Name="PngOptionsCard" Padding="16" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Visibility="Collapsed">
                            <StackPanel Spacing="12">
                                <TextBlock Text="PNG 选项" FontSize="14" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="120,*"><TextBlock Text="位深" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="BdPngCbo" Grid.Column="1" SelectionChanged="OnPerFormatSelectionChanged">
                                        <ComboBoxItem Tag="8" IsSelected="True">8-bit</ComboBoxItem>
