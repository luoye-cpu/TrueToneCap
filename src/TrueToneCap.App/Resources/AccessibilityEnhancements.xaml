<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <!-- ═══ WCAG 2.1 AA Accessibility Enhancement Styles ═══ -->
    <!-- 2026-11-08: Non-intrusive accessibility properties for MainWindow -->
    
    <!-- NavigationView item accessibility -->
    <Style TargetType="controls:NavigationViewItem">
        <Setter Property="AutomationProperties.Name" Value="{Binding Tag}"/>
        <Setter Property="AutomationProperties.HelpText" 
                Value="{Binding Content}"/>
    </Style>
    
    <!-- Output Settings Tab header -->
    <DataTemplate x:Key="OutputTabHeaderTemplate">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="F0 M20.15,6.69 L18.75,6.47 L18.5,5.39 L18.38,4.78 L17.67,2.18 L17.66,2.16 L17.56,1.82 L17.35,1.51 L17.04,1.3 L16.57,1.13 L13.12,1 L13,1 L2.96,1 L2.27,1 L1.87,1.17 L1.52,1.51 L1.31,1.97 L1.13,2.7L1,3.13 L1,18.6 L1.1,19.38 L1.16,19.78 L1.32,20.42 L1.49,20.87 L1.66,21.35 L1.85,21.82 L2.08,22.27 L2.34,22.69 L2.63,23.07 L2.96,23.4 L16.72,23.4 C18.36,23.4 19.88,22.78 21.04,21.72 C22.21,20.65 22.88,19.03 22.88,17.28 C22.88,15.96 22.46,14.74 21.75,13.71 L21.73,13.69 L20.55,12.02 L20.27,11.69 L21.79,10.14 L22.14,9.78 L22.2,9.41 L22.16,8.99 L21.65,8.18 L21.1,7.08 L20.15,6.69 ZM14.24,19.36 L5.3,19.36 L5.3,11.23 L14.24,11.23 ZM19.07,16.8 C19.07,17.9 18.69,18.91 18.07,19.73 L8.99,19.73 L8.99,11.9 L18.3,11.9 L17.17,13.66 L16.61,14.48 L16.41,14.86 L17.53,16.46 L18.31,17.68 L19.07,16.8 Z" 
                      AutomationProperties.Name="输出设置页标题" IsHitTestVisible="False"/>
            <TextBlock Text="输出设置" FontWeight="SemiBold"/>
        </StackPanel>
    </DataTemplate>
    
    <!-- Label styling with explicit automation relationships -->
    <Style TargetType="TextBlock" x:Key="AccessibleLabelStyle"/>
    
    <!-- Button shortcuts for keyboard navigation (F-keys) -->
    <!-- Note: These would be registered in code-behind via RegisterKeyboardAccelerator -->
    
    <!-- Focus visual template -->
    <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="FocusVisualMargin" Value="0"/>
        <Setter Property="FocusVisualPrimaryBrush" Value="#FFFF5722"/>
        <Setter Property="FocusVisualSecondaryBrush" Value="#FFBDBDBD"/>
    </Style>
    
    <!-- ComboBox with label association -->
    <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
        <Setter Property="FocusVisualMargin" Value="0"/>
    </Style>
    
</ResourceDictionary>