<local:MarkdownDocumentWindow x:Class="TrueToneCap.App.PrivacyPolicyWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TrueToneCap.App"
    Title="TrueToneCap 隐私政策"
    Closed="OnClosed">

    <!-- ═══ 隐私政策面（商店合规：微软商店政策 10.5.1 要求 Win32 产品提供隐私政策）═══
         与 ThirdPartyNoticesWindow 同构 —— 两者的外观与行为都由 MarkdownDocumentWindow 基类承担，
         本文件只提供"长什么样"。渲染逻辑不在这里（也不该在这里复制一份）。
         ⚠️ 本文件【不出现任何硬编码 Color / Brush 字面量】：颜色全部走 ThemeResource 键，
            且键集合限定在主窗口已在用的那几个（Light / Dark / OLED 三套主题下都可读）。 -->
    <Grid x:Name="RootGridControl" RowDefinitions="Auto,*,Auto">

        <!-- ── 顶部：标题 + 关闭 ── -->
        <Border Grid.Row="0" Padding="16,10" Background="{ThemeResource CardBackgroundFillColorDefault}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderTitleTxt" Text="隐私政策" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="HeaderHintTxt" FontSize="11" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="本应用的数据处理方式（只读展示）"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="CloseBtn" Height="32" Padding="12,0"
                        VerticalAlignment="Center" Click="OnCloseClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Width="14" Height="14" Data="F0 M11.17,10 L20,18.85 L18.85,20 L10,11.17 L1.15,20 L0,18.85 L8.83,10 L0,1.15 L1.15,0 L10,8.83 L18.85,0 L20,1.15 Z"/>
                        <TextBlock x:Name="CloseBtnTxt" Text="关闭" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ── 正文：整份隐私政策可纵向滚到底 ──
             横向滚动是给等宽表格行用的；ScrollViewer 一旦允许横向滚动就会用无限宽度量内容，
             正文的 TextWrapping 会失效。解法同致谢窗口：把内容面板 MinWidth 钉在视口宽度上，
             由基类的 SyncContentWidth 在 SizeChanged 时同步。 -->
        <ScrollViewer x:Name="BodyScrollControl" Grid.Row="1" Padding="16,12"
                      Background="{ThemeResource SolidBackgroundFillColorBase}"
                      IsTabStop="True"
                      VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel x:Name="ContentPanelControl" Spacing="4"/>
        </ScrollViewer>

        <!-- ── 降级：文件找不到时明确说出来（不抛异常、也不静默留白）── -->
        <Border x:Name="MissingPanelControl" Grid.Row="1" Visibility="Collapsed" Padding="24"
                Background="{ThemeResource SolidBackgroundFillColorBase}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" MaxWidth="720">
                <TextBlock x:Name="MissingTitleTxtControl" Text="未找到 PRIVACY.md"
                           FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="MissingHintTxtControl" FontSize="12" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="MissingPathsTxtControl" FontSize="11" TextWrapping="Wrap"
                           FontFamily="Consolas" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- ── 底部：实际读到的文件与规模（用户/审计需要确认"看的就是包里这份"）── -->
        <Border Grid.Row="2" Padding="16,8" Background="{ThemeResource CardBackgroundFillColorDefault}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="FooterTxtControl" FontSize="11" TextWrapping="Wrap"
                       IsTextSelectionEnabled="True"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Border>
    </Grid>
</local:MarkdownDocumentWindow>
