<Window x:Class="TrueToneCap.App.OcrPreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="TrueToneCap 文字识别"
    Closed="OnClosed">

    <Grid x:Name="RootGrid" RowDefinitions="Auto,*,Auto">
        <!-- ═══ 工具栏 ═══ -->
        <Border Grid.Row="0" Padding="12,8" Background="{ThemeResource CardBackgroundFillColorDefault}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <ToggleButton x:Name="ModeToggle" Height="32" Padding="12,0"
                                  Checked="OnModeToggleChanged" Unchecked="OnModeToggleChanged"
                                  ToolTipService.ToolTip="切换原文高亮 / 译文覆盖">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8D4;" FontSize="14"/>
                            <TextBlock Text="显示译文" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                    <Button x:Name="TranslateBtn" Height="32" Padding="12,0" Click="OnTranslateClick"
                            ToolTipService.ToolTip="翻译识别到的文字">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE774;" FontSize="14"/>
                            <TextBlock Text="翻译" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Height="32" Padding="12,0" Click="OnCopyAllClick" ToolTipService.ToolTip="复制全部文字">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8C8;" FontSize="14"/>
                            <TextBlock Text="复制全部" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Height="32" Padding="12,0" Click="OnSaveClick" ToolTipService.ToolTip="保存截图">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74E;" FontSize="14"/>
                            <TextBlock Text="保存" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Height="32" Padding="12,0" Click="OnCloseClick" ToolTipService.ToolTip="关闭 (Esc)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE10A;" FontSize="14"/>
                            <TextBlock Text="关闭" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ 画布区域 ═══ -->
        <Border Grid.Row="1" Background="#FF1A1A2E">
            <Grid x:Name="CanvasGrid" Background="Transparent">
                <Image x:Name="PreviewImage" Stretch="Uniform"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Canvas x:Name="OverlayCanvas" Background="Transparent"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsHitTestVisible="True"/>
            </Grid>
        </Border>

        <!-- ═══ 底部状态栏 ═══ -->
        <Border Grid.Row="2" Padding="14,10" Background="{ThemeResource CardBackgroundFillColorDefault}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="InfoTxt" Text="点击文字块复制该行 · 切换「显示译文」查看翻译 · Esc 关闭"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
