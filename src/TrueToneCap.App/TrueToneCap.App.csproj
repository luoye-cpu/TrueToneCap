<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 公共属性见 ../../Directory.Build.props -->
    <OutputType>WinExe</OutputType>
    <!-- 自包含发布（RID/SelfContained 因仅本项目与 LogViewer 需要，故在项目内声明） -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- ⚠️ 这两个 true 是【默认值】，可被下面的 TtcFrameworkDependent 覆盖 —— 见该开关的注释。 -->
    <SelfContained Condition="'$(TtcFrameworkDependent)' != 'true'">true</SelfContained>
    <!-- <Platform> 会影响输出路径，故在项目内声明（原仓库仅有 App 与 LogViewer 声明） -->
    <Platform>x64</Platform>
    <RootNamespace>TrueToneCap.App</RootNamespace>
    <AssemblyName>TrueToneCap</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained Condition="'$(TtcFrameworkDependent)' != 'true'">true</WindowsAppSDKSelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationTitle>TrueToneCap</ApplicationTitle>
    <ApplicationId>com.trueonecap.app</ApplicationId>

    <!-- ═══ 压制 XAML 运行时绑定裁剪警告（AOT 下日志面板绑定安全） ═══ -->
    <SuppressXamlTrimWarnings>true</SuppressXamlTrimWarnings>

    <!-- ═══════════════════════════════════════════════════════════════════
         MSIX 打包开关（2026-10-07）—— 【默认关闭，不影响未打包构建】
         ═══════════════════════════════════════════════════════════════════
         用法:  dotnet build src/TrueToneCap.App -c Release -p:Platform=x64 -p:TtcMsixPackage=true
                （或 .\Publish.ps1 -Msix）

         为什么写成"一个开关带动一整套属性"，而不是把 MSIX 属性直接写死：
           MSIX 打包 targets 里有一条**二选一的硬规则**（实测自
           Microsoft.Windows.SDK.BuildTools.MSIX.Packaging.targets:412 附近）：
             · WindowsPackageType != None 且【没有】AppxManifest 项  => 报错
             · WindowsPackageType == None 且【有】AppxManifest 项     => 报错
           即"配置必须成套，不能只改一半"。实测教训：只把 WindowsPackageType 改成 MSIX
           会【构建成功但不产出任何包】（假成功）；补上 EnableMsixTooling 才会报出
           "no AppxManifest is specified" 的真实要求。
           ⇒ 这里用条件块把四个属性 + AppxManifest 项绑在一起，避免出现"半套配置"。
         ═══════════════════════════════════════════════════════════════════ -->
    <TtcMsixPackage Condition="'$(TtcMsixPackage)' == ''">false</TtcMsixPackage>

    <!-- ═══════════════════════════════════════════════════════════════════
         框架依赖开关（2026-10-07）—— 【默认关闭，保持自包含】
         ═══════════════════════════════════════════════════════════════════
         用法:  .\Publish.ps1 -Msix -FrameworkDependent
                或 dotnet build ... -p:TtcMsixPackage=true -p:TtcFrameworkDependent=true

         为什么需要它 —— 实测体积（同一台机器、同一份源码，只翻这两个属性）:
           全自包含（默认） 150.90 MB
           仅 WinAppSDK 框架依赖 121.89 MB   (-29.0)
           仅 .NET 框架依赖      113.58 MB   (-37.3)
           两者都框架依赖        84.57 MB   (-66.3，-44%)
         顺带说明"为什么压缩救不了"：MSIX 用的是 Deflate，且 makeappx 只提供 /nc
         （关闭压缩）、没有压缩级别参数 ⇒ 已压到 44.5% 就是上限。要瘦身只能"少放东西"。

         ⚠️ 关键取舍 —— 这是【用绿色包的易用性换商店包的体积】：
           本仓同时维护两条分发路径。改框架依赖后，MSIX 由商店/Windows 自动装运行时依赖，
           对商店用户无障碍；但**绿色包**（解压即用）会要求用户预装 .NET 与 WinAppSDK 运行时。
           ⇒ 因此本开关【只该作用于商店包】，绿色包保持自包含。
             实现方式：开关独立于 TtcMsixPackage，不联动 —— 谁需要谁显式传。
             若将来想让"绿色包也框架依赖"，须同时提供运行时安装器，那是另一件事。

         ⚠️ 与 TtcMsixPackage 的耦合：不做强制绑定。
           只传 TtcFrameworkDependent 而不传 TtcMsixPackage 时，会产出一个
           **框架依赖的未打包构建** —— 那是合法用法（例如本地快速验证依赖是否齐全），
           故不报错；但发布/上架场景应两者同时传，Publish.ps1 已保证这一点。
         ═══════════════════════════════════════════════════════════════════ -->
    <TtcFrameworkDependent Condition="'$(TtcFrameworkDependent)' == ''">false</TtcFrameworkDependent>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TtcFrameworkDependent)' == 'true'">
    <!-- .NET 运行时交给目标机（商店包由 Windows 自动解析依赖） -->
    <SelfContained>false</SelfContained>
    <!-- WinAppSDK 运行时交给框架包（官方文档明确：打包形态下依赖作为包内容，
         框架依赖形态则由系统/商店安装 Microsoft.WindowsAppRuntime） -->
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <!-- ⚠️ 框架依赖时不能再复用自包含时代的 R2R 复合映像假设：
         显式关闭 R2R，避免产出"引用自包含运行时布局"的映像。
         体积上也是净收益（R2R 复合映像本就不进 MSIX 包，见 doc 分析）。 -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishReadyToRunComposite>false</PublishReadyToRunComposite>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TtcMsixPackage)' == 'true'">
    <WindowsPackageType>MSIX</WindowsPackageType>
    <!-- 必须显式开：否则 MSIX 打包 targets 根本不介入（只改 WindowsPackageType 时
         构建会"成功但不产包"） -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- 本地/CI 出包时关闭签名：商店会在认证通过后用微软证书**自动重签**，
         所以上架【不需要】购买代码签名证书。侧载/企业分发才需要自签。 -->
    <AppxPackageSigningEnabled Condition="'$(AppxPackageSigningEnabled)' == ''">false</AppxPackageSigningEnabled>
    <!-- 没有它，dotnet build 只做编译、不产出 .msix -->
    <GenerateAppxPackageOnBuild Condition="'$(GenerateAppxPackageOnBuild)' == ''">true</GenerateAppxPackageOnBuild>
    <!-- 输出目录名（AppPackages/<name>_<ver>_<arch>_Test/）由 SDK 决定，此处不覆写 -->
    <AppxBundle Condition="'$(AppxBundle)' == ''">Never</AppxBundle>
    <!-- Identity/@Version 的第四段必须为 0（商店规定）。AssemblyVersion 已是 x.y.z.0 -->
    <AppxPackageDir Condition="'$(AppxPackageDir)' == ''">$(MSBuildProjectDirectory)\AppPackages\</AppxPackageDir>

    <!-- ═══ 符号包（.appxsym）═══
         Partner Center 的**崩溃分析**依赖它。缺了不影响提交（官方明确可省略），
         但出了崩溃就没有可用堆栈 —— 对一个要上架的应用不值得省。
         ⚠️ 裸 `dotnet build` 下 SDK 找不到 mspdbcmf.exe 并警告
            "Path to `mspdbcmf.exe` could not be found. A symbols package will not be generated."
            根因（读 targets 原文得出，非猜测）：`_EnsurePdbCmfExeFullPath` 只从两处找它 ——
             ① $(VCToolsInstallDir)bin\Host*\x64\  ← 依赖 VC 工具集环境变量
             ② $(AppxMSBuildToolsPath)\x64\        ← 依赖 $(MSBuildExtensionsPath) 解析到 VS
            裸 dotnet build（不经过 vcvarsall/dev prompt）两条都落空。
            ⚠️ 正确的属性名是 **MsPdbCmfExeFullpath**（注意大小写：Fullpath 不是 FullPath）。
               实测教训：先前按直觉写的 `MspdbcmfPath` 是**无效的** —— 打包仍报警告；
               因为该 target 的条件是 `'$(MsPdbCmfExeFullpath)' == ''`，名字不对等于没设。
               设上它，整个解析 target 直接短路，警告消失。
            实测该文件存在于 VS 的 AppxPackage\x64\ 与 VC\Tools\MSVC\...\Hostx64\x64\ 两处。 -->
    <_TtcMspdbCmf Condition="'$(_TtcMspdbCmf)' == '' AND Exists('$(MSBuildProgramFiles32)\Microsoft Visual Studio\18\Community\MSBuild\Microsoft\VisualStudio\v18.0\AppxPackage\x64\MsPdbCmf.exe')">$(MSBuildProgramFiles32)\Microsoft Visual Studio\18\Community\MSBuild\Microsoft\VisualStudio\v18.0\AppxPackage\x64\MsPdbCmf.exe</_TtcMspdbCmf>
    <_TtcMspdbCmf Condition="'$(_TtcMspdbCmf)' == '' AND Exists('$(ProgramFiles)\Microsoft Visual Studio\18\Community\MSBuild\Microsoft\VisualStudio\v18.0\AppxPackage\x64\MsPdbCmf.exe')">$(ProgramFiles)\Microsoft Visual Studio\18\Community\MSBuild\Microsoft\VisualStudio\v18.0\AppxPackage\x64\MsPdbCmf.exe</_TtcMspdbCmf>
    <MsPdbCmfExeFullpath Condition="'$(MsPdbCmfExeFullpath)' == '' AND '$(_TtcMspdbCmf)' != ''">$(_TtcMspdbCmf)</MsPdbCmfExeFullpath>
  </PropertyGroup>

  <ItemGroup Condition="'$(TtcMsixPackage)' == 'true'">
    <!-- 与 WindowsPackageType=MSIX 配套，缺一即报 "Improper project configuration" -->
    <AppxManifest Include="Package.appxmanifest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Graphics.Win2D" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TrueToneCap.Core\TrueToneCap.Core.csproj" />
  </ItemGroup>

  <!-- ═══ AOT 兼容：JSON 源生成器 + 裁剪根配置 ═══ -->
  <ItemGroup>
    <TrimmerRootDescriptor Include="$(MSBuildProjectDirectory)\..\..\TrimmerRoots.xml" />
  </ItemGroup>

  <!-- ═══ ReadyToRun ═══
       ReadyToRun 默认由 Publish.ps1 以命令行 -p: 开启（复合映像）；
       此处不设默认值，避免与脚本的命令行参数产生双源冲突。 -->

  <!-- 数据文件 + OCR 模型 → 输出到 data/ -->
  <ItemGroup>
    <!-- 显式 Link 而非 LinkBase：WinUI 构建目标下 LinkBase 对 Content 未生效，导致 bin 输出到 Shaders/ 而非 data/Shaders -->
    <Content Include="Shaders\*.hlsl" CopyToOutputDirectory="PreserveNewest" Visible="false" Link="data\Shaders\%(Filename)%(Extension)" />
    <!-- ⚠️ 此处【刻意不】写 Shaders\*.cso —— 见下方 CollectCompiledShaders Target 的说明。
         静态 glob 在评估阶段展开，会把构建期刚生成的 .cso 漏掉。 -->
    <Content Include="Shaders\*.ps1" CopyToOutputDirectory="PreserveNewest" Visible="false" Link="data\Shaders\%(Filename)%(Extension)" />
    <Content Include="Models\*.txt" CopyToOutputDirectory="PreserveNewest" Visible="false" Link="data\Models\%(Filename)%(Extension)" />
    <!-- PP-OCRv6 ONNX 模型 (FP16, 内置分发)
         必须用显式 Link 而非 LinkBase（理由见上方注释）：此前用 LinkBase 时 .onnx 会落到
         bin 根目录的 Models\，而 .txt 落在 data\Models\，导致 OnnxOcrEngine.FindFirstExisting
         只在单一目录内查找，从 bin 输出运行（IDE 调试 / dotnet run）时找不到字典，
         OCR 直接失败；仅 publish 产物因 CopyPriAndXbf 的兜底移动才正常。 -->
    <Content Include="Models\*.onnx" CopyToOutputDirectory="PreserveNewest" Visible="false" Link="data\Models\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- ═══ 第三方许可致谢文件 → 输出目录根（与 exe 同目录）═══
       ThirdPartyNoticesWindow 的第一查找位置就是 AppContext.BaseDirectory，
       发布包与"直接从 bin 里跑 exe"都靠这一条把文件放到它眼前。

       ⚠ Condition="Exists(...)" 不是装饰，是必需：Content 指向的文件不存在时，
         复制任务直接报 MSB3030（"复制文件时出错"）⇒ 整条构建失败。
         该文件由主循环/发布流程维护，本项目不拥有它 —— 缺失时宁可少一份拷贝
         （应用侧已有"未找到 THIRD-PARTY-NOTICES.md"的降级界面），也不能拖垮构建。

       ⚠ 必须显式 Link：本项目 LinkBase 对 Content 不生效（见上方 Shaders / Models 那几条同一条理由），
         且此文件在仓库根、逃出项目目录，不 Link 时输出侧的相对路径形状不可控。

       ⚠ 路径锚在 $(MSBuildProjectDirectory) 上，【不】写成相对的 ..\..\ ：
         Exists() 这类属性函数里的相对路径是按「MSBuild 进程当前目录」解析的，而当前目录
         取决于从哪儿发起构建 —— 从仓库根构建（本仓的正式入口就是根上的 .slnx）时，
         '..\..\THIRD-PARTY-NOTICES.md' 会指到 C:\PLAN\ 下面 ⇒ 恒为 false ⇒ 静默不复制，
         表现是"文件明明在，界面却说未找到"。 -->
  <PropertyGroup>
    <TtcThirdPartyNotices>$(MSBuildProjectDirectory)\..\..\THIRD-PARTY-NOTICES.md</TtcThirdPartyNotices>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="$(TtcThirdPartyNotices)" Condition="Exists('$(TtcThirdPartyNotices)')"
             CopyToOutputDirectory="PreserveNewest" Visible="false" Link="THIRD-PARTY-NOTICES.md" />
  </ItemGroup>

  <!-- ═══ 隐私政策 → 输出目录根（与 exe 同目录）═══
       为什么要有这一条：微软商店政策 10.5.1 对 Win32 / Desktop Bridge 产品【强制】要求
       提供隐私政策且"用户能够访问"，本应用内入口是 PrivacyPolicyWindow，
       它的第一查找位置就是 AppContext.BaseDirectory —— 文件不随包分发，入口就只剩降级界面。
       ⚠ 与 THIRD-PARTY-NOTICES.md 完全同一套约束，逐条同因，不重复解释：
         · Condition="Exists(...)" 必需（否则缺文件时 MSB3030 直接拖垮构建）；
         · 必须显式 Link（本项目 LinkBase 对 Content 不生效）；
         · 路径锚在 $(MSBuildProjectDirectory) 上，不写成 ..\..\（Exists() 的相对路径
           按 MSBuild 进程当前目录解析，从仓库根构建时会指错 ⇒ 恒 false ⇒ 静默不复制）。
       单一事实源：仓库根 PRIVACY.md（本仓库拥有它，不存在"由外部流程维护"的情况，
       故它缺失属于真异常 —— 但这里仍保留 Exists 守卫，理由同许可文件：
       宁可少一份拷贝并走降级界面，也不要让构建挂掉）。 -->
  <PropertyGroup>
    <TtcPrivacyPolicy>$(MSBuildProjectDirectory)\..\..\PRIVACY.md</TtcPrivacyPolicy>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="$(TtcPrivacyPolicy)" Condition="Exists('$(TtcPrivacyPolicy)')"
             CopyToOutputDirectory="PreserveNewest" Visible="false" Link="PRIVACY.md" />
  </ItemGroup>

  <!-- PreBuild: 自动编译 HLSL 着色器（仅在 .cso 缺失或过期时触发）。
       Inputs/Outputs 与 CompileShaders.ps1 实际产出对齐：
       脚本产出 "<Shader>.hlsl.cso"，故 Outputs 写 *.hlsl.cso —— 与 Shaders/ 目录下
       实际存在的文件名一致，增量构建可正确判定。
       2026-10-01：ToneMapping.hlsl 连同其运行时加载方 GpuToneMapper 一起删除（清单里有、没人加载）。
       这份清单与 Shaders/*.hlsl、ShaderCompiler.cs 三处的一致性由
       CorePipelineTests.Test_ShaderList_HasNoOrphanEntry 在门禁里对账——CompileShaders.ps1 那份自检
       带 Inputs/Outputs 增量判定，cs 文件改了而 .cso 没过期时它整段不跑。 -->
  <Target Name="CompileShaders" BeforeTargets="Build" Inputs="Shaders\FullscreenVS.hlsl;Shaders\OverlayComposite.hlsl" Outputs="Shaders\FullscreenVS.hlsl.cso;Shaders\OverlayComposite.hlsl.cso">
    <Message Text="编译 HLSL 着色器..." Importance="high" />

    <!-- 宿主探测: 优先 PowerShell 7 (pwsh)，不存在则回退 Windows PowerShell 5.1 (powershell)。
         ⚠️ 不要写死 `powershell`：只装了 PowerShell 7 的机器上该命令不存在，构建直接失败。
            写死 `pwsh` 同理会误伤只装 5.1 的机器（含多数 self-hosted 运行器）。 -->
    <Exec Command="where pwsh &gt;NUL 2&gt;&amp;1" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="TtcHasPwsh" />
    </Exec>
    <PropertyGroup>
      <TtcPsExe Condition="'$(TtcHasPwsh)' == '0'">pwsh</TtcPsExe>
      <TtcPsExe Condition="'$(TtcHasPwsh)' != '0'">powershell</TtcPsExe>
    </PropertyGroup>
    <Message Text="使用 PowerShell 宿主: $(TtcPsExe)" Importance="normal" />

    <Exec Command="&quot;$(TtcPsExe)&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Shaders\CompileShaders.ps1&quot; -ShaderDir &quot;$(MSBuildProjectDirectory)\Shaders&quot; -OutputDir &quot;$(MSBuildProjectDirectory)\Shaders&quot;" />
  </Target>

  <!-- 收集构建期生成的 .cso —— 必须在 Target 内【动态】添加。
       ⚠️ 不能把 Shaders\*.cso 写进静态 ItemGroup：静态 glob 在项目【评估阶段】展开，
          而 CompileShaders Target 在其之后才生成 .cso —— 展开时文件尚不存在，
          于是本轮不会被复制。实测（2026-09-14）：清空 .cso 后单次构建，
          fxc 日志显示编译成功，但 bin/**/data/Shaders 下 0 个 .cso，第二次构建才有。
          因 *.cso 被 .gitignore 排除、不入库，全新克隆与 CI 干净检出必然踩到，
          表现为首次 publish 被 verify-package.ps1 [3/5] 拒绝。

       本 Target 刻意【不带 Inputs/Outputs】：即使 CompileShaders 因增量判定被跳过，
       已存在的 .cso 也必须每次都进入复制列表，否则第二次构建又会把它们漏掉。 -->
  <Target Name="CollectCompiledShaders" BeforeTargets="AssignTargetPaths" DependsOnTargets="CompileShaders">
    <ItemGroup>
      <_TtcCsoFile Include="Shaders\*.cso" />
      <!-- ⚠️ Target 内必须用【限定元数据】 %(_TtcCsoFile.Filename)：
           写成不限定的 %(Filename) 会触发 MSBuild 对整个 Content 集合做任务批处理，
           把模型等其它 Content 的 Link 一并改写成最后一个值
           （实测 2026-09-14：模型被复制进了 data\Shaders，并报 MSB3026 文件占用）。 -->
      <Content Include="@(_TtcCsoFile)">
        <Link>data\Shaders\%(_TtcCsoFile.Filename)%(_TtcCsoFile.Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <Visible>false</Visible>
      </Content>
    </ItemGroup>
  </Target>

  <!-- Post-publish: 整理发布目录（PRI/XBF 复制 + 目录规整）。
       注意: 本 Target 是 PRI/XBF/PDB 处理的唯一实现，Publish.ps1 不再重复执行同样逻辑。 -->
  <Target Name="CopyPriAndXbf" AfterTargets="Publish">
    <ItemGroup>
      <!-- WinAppSDK 2.x: 应用级 PRI 可能不再生成（资源合并到 WindowsAppRuntime.pri） -->
      <_PriFiles Include="$(OutputPath)TrueToneCap.pri" Condition="Exists('$(OutputPath)TrueToneCap.pri')" />
      <_XbfFiles Include="$(OutputPath)*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="@(_PriFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="'@(_PriFiles)' != ''" />
    <Copy SourceFiles="@(_XbfFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="'@(_XbfFiles)' != ''" />

    <!-- 创建 data/ 子目录 -->
    <MakeDir Directories="$(PublishDir)data" />

    <!-- 移动 .pdb 调试符号到 data/ -->
    <ItemGroup>
      <_PdbFiles Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Move SourceFiles="@(_PdbFiles)" DestinationFolder="$(PublishDir)data\" />

    <!-- 移动遗留的根目录 Models/ Shaders/ 到 data/ (兼容旧构建) -->
    <ItemGroup>
      <_LegacyModels Include="$(PublishDir)Models\**\*" Condition="Exists('$(PublishDir)Models')" />
      <_LegacyShaders Include="$(PublishDir)Shaders\**\*" Condition="Exists('$(PublishDir)Shaders')" />
    </ItemGroup>
    <Move SourceFiles="@(_LegacyModels)" DestinationFolder="$(PublishDir)data\Models\" Condition="'@(_LegacyModels)' != ''" />
    <Move SourceFiles="@(_LegacyShaders)" DestinationFolder="$(PublishDir)data\Shaders\" Condition="'@(_LegacyShaders)' != ''" />
    <RemoveDir Directories="$(PublishDir)Models" Condition="Exists('$(PublishDir)Models')" />
    <RemoveDir Directories="$(PublishDir)Shaders" Condition="Exists('$(PublishDir)Shaders')" />

    <!-- Native/ 死目录清理 -->
    <RemoveDir Directories="$(PublishDir)Native" Condition="Exists('$(PublishDir)Native')" />

    <Message Text="[TrueToneCap] ✅ 目录整理完成" Importance="high" />
  </Target>

  <!-- AfterBuild: 把随包原生编码器按【发布包同一份布局】放进开发构建输出的 native/。
       为什么必须有：Core.dll 里【没有】嵌入资源（口径与实测见 Core/Services/NativeLibraryResolver.cs 文件头），
       提取逻辑真正依赖的是"BaseDirectory 下找得到 exe"那条文件系统回退链，而喂这条链的一直只有
       Publish.ps1 的 [3/6]。后果：裸 dotnet build 的 bin 里 native/ 是空的 ⇒
       AVIF / JPEG XL / WebP / JPEG LI 四种格式在开发构建上必走保底 —— 2026-10-01 实机轮就因此
       把"选 JPEG XL 拿到 PNG"读成了产品行为（其实是布局缺件）。
       单一事实源仍是 Core/Resources/（Publish.ps1 的 $toolsSrc 同一个目录），这里只是多拷一份到开发输出，
       不是第二份事实。计数写成硬断言：少一枚就是布局坏了，不许静默少拷。

       ═══ 2026-10-07 MSIX 打包修复：从"只 Copy"改为"声明 Content 项 + Copy" ═══
       ⚠️ 原实现只用 `<Copy DestinationFolder="$(OutDir)native">` —— 那是**文件系统动作**，
          而 **MSIX 打包枚举的是 MSBuild 声明的项（items），不是输出目录里的文件**。
          实测后果（解包核对）：native/ 下 4 枚 exe **全部漏在包外**，
          而 OCR 模型（走 <Content Include="Models\*.onnx">）能进包 —— 因为后者是声明的项。
          ⇒ AVIF / JPEG XL / WebP / JPEG LI 四种格式在 MSIX 包里会整体失效，
            而 build / publish / 打包**全程绿灯**（典型的"构建成功但功能坏了"）。
       ⇒ 现在把同一批文件**声明为 Content 项**（Link 到 native\%(Filename)%(Extension)），
         MSIX 打包即可枚举到；同时 `CopyToOutputDirectory=PreserveNewest` 保留原有的
         "开发构建输出里也有 native/" 行为，不必再依赖下面的 Copy 动作。
       ⚠️ 保留下面的 Copy 作为兜底（SkipUnchangedFiles 使其在 Content 已复制时近乎零成本），
          并保留 4 枚的硬断言 —— 断言现在同时覆盖 Build 与打包两条路径。 -->
  <ItemGroup>
    <!-- 单一事实源：Core/Resources/。Link 必须写到 native/ 子目录，
         因为 NativeLibraryResolver 只在 BaseDirectory/native 下找（见其 :61）。 -->
    <Content Include="..\TrueToneCap.Core\Resources\*.exe"
             Link="native\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             Visible="false" />
  </ItemGroup>

  <Target Name="CopyNativeToolsToDevOutput" AfterTargets="Build">
    <ItemGroup>
      <TtcNativeTools Include="..\TrueToneCap.Core\Resources\*.exe" />
    </ItemGroup>
    <Error Text="Core/Resources/ 下应有 4 枚原生编码器 exe（实得 @(TtcNativeTools->Count())）⇒ 布局或检出坏了，native/ 不许静默少拷"
           Condition="'@(TtcNativeTools->Count())' != '4'" />
    <Copy SourceFiles="@(TtcNativeTools)"
          DestinationFolder="$(OutDir)native"
          SkipUnchangedFiles="true"
          Condition="'@(TtcNativeTools)' != ''" />
  </Target>

</Project>
