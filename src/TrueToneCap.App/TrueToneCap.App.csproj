<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <LangVersion>13</LangVersion>
    <Nullable>enable</Nullable>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TrueToneCap.App</RootNamespace>
    <AssemblyName>TrueToneCap</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationTitle>TrueToneCap</ApplicationTitle>
    <ApplicationId>com.trueonecap.app</ApplicationId>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.2.0-beta</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <CodeAnalysisRuleSet></CodeAnalysisRuleSet>
    <NoWarn>$(NoWarn);MSB3884</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TrueToneCap.Core\TrueToneCap.Core.csproj" />
  </ItemGroup>

  <!-- 内嵌字体 + 数据文件 + OCR 模型 → 输出到 data/ -->
  <ItemGroup>
    <Content Include="Fonts\**\*.ttf" CopyToOutputDirectory="PreserveNewest" Visible="false" LinkBase="data\Fonts\" />
    <Content Include="Fonts\**\*.otf" CopyToOutputDirectory="PreserveNewest" Visible="false" LinkBase="data\Fonts\" />
    <Content Include="Shaders\*.hlsl" CopyToOutputDirectory="PreserveNewest" Visible="false" LinkBase="data\Shaders\" />
    <Content Include="Shaders\*.cso" CopyToOutputDirectory="PreserveNewest" Visible="false" LinkBase="data\Shaders\" />
    <Content Include="Shaders\*.ps1" CopyToOutputDirectory="PreserveNewest" Visible="false" LinkBase="data\Shaders\" />
    <Content Include="Models\*.txt" CopyToOutputDirectory="PreserveNewest" Visible="false" LinkBase="data\Models\" />
    <!-- PP-OCRv6 ONNX 模型 (FP16, 内置分发) -->
    <Content Include="Models\*.onnx" CopyToOutputDirectory="PreserveNewest" Visible="false" LinkBase="data\Models\" />
  </ItemGroup>

  <!-- PreBuild: 自动编译 HLSL 着色器（仅在 .cso 缺失或过期时触发） -->
  <Target Name="CompileShaders" BeforeTargets="Build" Inputs="Shaders\ToneMapping.hlsl;Shaders\MosaicEffect.hlsl;Shaders\FullscreenVS.hlsl" Outputs="Shaders\ToneMapping.hlsl.cso;Shaders\MosaicEffect.hlsl.cso;Shaders\FullscreenVS.hlsl.cso">
    <Message Text="编译 HLSL 着色器..." Importance="high" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Shaders\CompileShaders.ps1&quot; -ShaderDir &quot;$(MSBuildProjectDirectory)\Shaders&quot; -OutputDir &quot;$(MSBuildProjectDirectory)\Shaders&quot;" />
  </Target>

  <!-- Post-publish: 复制 PRI/XBF + 整理目录 -->
  <Target Name="CopyPriAndXbf" AfterTargets="Publish">
    <ItemGroup>
      <!-- WinAppSDK 2.x: 应用级 PRI 可能不再生成（资源合并到 WindowsAppRuntime.pri） -->
      <_PriFiles Include="$(OutputPath)TrueToneCap.pri" Condition="Exists('$(OutputPath)TrueToneCap.pri')" />
      <_XbfFiles Include="$(OutputPath)*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="@(_PriFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="'@(_PriFiles)' != ''" />
    <Copy SourceFiles="@(_XbfFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="'@(_XbfFiles)' != ''" />

    <!-- 创建 data/ 子目录 -->
    <MakeDir Directories="$(PublishDir)data" />

    <!-- 移动 .pdb 调试符号到 data/ -->
    <ItemGroup>
      <_PdbFiles Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Move SourceFiles="@(_PdbFiles)" DestinationFolder="$(PublishDir)data\" />

    <!-- 移动遗留的根目录 Fonts/ Models/ Shaders/ 到 data/ (兼容旧构建) -->
    <ItemGroup>
      <_LegacyFonts Include="$(PublishDir)Fonts\**\*" Condition="Exists('$(PublishDir)Fonts')" />
      <_LegacyModels Include="$(PublishDir)Models\**\*" Condition="Exists('$(PublishDir)Models')" />
      <_LegacyShaders Include="$(PublishDir)Shaders\**\*" Condition="Exists('$(PublishDir)Shaders')" />
    </ItemGroup>
    <Move SourceFiles="@(_LegacyFonts)" DestinationFolder="$(PublishDir)data\Fonts\" Condition="'@(_LegacyFonts)' != ''" />
    <Move SourceFiles="@(_LegacyModels)" DestinationFolder="$(PublishDir)data\Models\" Condition="'@(_LegacyModels)' != ''" />
    <Move SourceFiles="@(_LegacyShaders)" DestinationFolder="$(PublishDir)data\Shaders\" Condition="'@(_LegacyShaders)' != ''" />
    <RemoveDir Directories="$(PublishDir)Fonts" Condition="Exists('$(PublishDir)Fonts')" />
    <RemoveDir Directories="$(PublishDir)Models" Condition="Exists('$(PublishDir)Models')" />
    <RemoveDir Directories="$(PublishDir)Shaders" Condition="Exists('$(PublishDir)Shaders')" />

    <!-- Native/ 死目录清理 -->
    <RemoveDir Directories="$(PublishDir)Native" Condition="Exists('$(PublishDir)Native')" />

    <Message Text="[TrueToneCap] ✅ 目录整理完成" Importance="high" />
  </Target>

</Project>
