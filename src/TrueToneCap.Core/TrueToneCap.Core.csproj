<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0-windows10.0.26100.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- 允许捕获 P/Invoke CSE (AccessViolationException/SEHException)，防止原生编码器崩溃终止进程 -->
    <LegacyCorruptedStateExceptionsPolicy>true</LegacyCorruptedStateExceptionsPolicy>
    <RootNamespace>TrueToneCap.Core</RootNamespace>
    <AssemblyName>TrueToneCap.Core</AssemblyName>
    <CodeAnalysisRuleSet></CodeAnalysisRuleSet>
    <NoWarn>$(NoWarn);MSB3884</NoWarn>
    <InternalsVisibleTo>TrueToneCap.Test</InternalsVisibleTo>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="JxlNet" Version="0.11.2.2" />
    <PackageReference Include="MozJpegSharp.Core" Version="3.0.8" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
    <PackageReference Include="libwebp" Version="1.0.0" />
  </ItemGroup>
</Project>
