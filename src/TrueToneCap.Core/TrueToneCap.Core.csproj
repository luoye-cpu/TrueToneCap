<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0-windows10.0.26100.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>TrueToneCap.Core</RootNamespace>
    <AssemblyName>TrueToneCap.Core</AssemblyName>
    <CodeAnalysisRuleSet></CodeAnalysisRuleSet>
    <NoWarn>$(NoWarn);MSB3884</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
  </ItemGroup>
  <!-- 嵌入原生工具链 (avifenc.exe / cwebp.exe / cjpegli.exe / cjxl.exe) 作为嵌入资源 -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\avifenc.exe" />
    <EmbeddedResource Include="Resources\cwebp.exe" />
    <EmbeddedResource Include="Resources\cjpegli.exe" />
    <EmbeddedResource Include="Resources\cjxl.exe" />
  </ItemGroup>
</Project>
