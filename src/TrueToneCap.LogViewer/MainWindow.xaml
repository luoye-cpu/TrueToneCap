<Window x:Class="TrueToneCap.LogViewer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TTC 日志查看器">
  <Grid x:Name="RootGrid" RequestedTheme="Dark" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Padding="12,10" ColumnSpacing="8" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button x:Name="RefreshBtn" Click="OnRefreshClick" ToolTipService.ToolTip="刷新文件列表"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE72C;" FontSize="14"/><TextBlock Text="刷新"/></StackPanel></Button>
      <Button x:Name="OpenDirBtn" Click="OnOpenDirClick" ToolTipService.ToolTip="选择日志目录"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE838;" FontSize="14"/><TextBlock Text="选择目录"/></StackPanel></Button>
      <ComboBox x:Name="LevelFilterCbo" SelectionChanged="OnFilterChanged"><ComboBoxItem Content="全部"/><ComboBoxItem Content="错误"/><ComboBoxItem Content="警告"/><ComboBoxItem Content="信息"/><ComboBoxItem Content="调试"/></ComboBox>
      <TextBox x:Name="SearchTxt" PlaceholderText="🔍 搜索日志..." TextChanged="OnSearchChanged"/>
      <Button x:Name="ClearOldBtn" Click="OnClearOldClick" ToolTipService.ToolTip="删除 30 天前的日志文件"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE74D;" FontSize="14"/><TextBlock Text="清理过期"/></StackPanel></Button>
      <Button x:Name="ClearAllBtn" Click="OnClearAllClick" ToolTipService.ToolTip="删除全部日志文件"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE74D;" FontSize="14"/><TextBlock Text="清空"/></StackPanel></Button>
    </Grid>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="DirTxt" Grid.Row="0" Text="日志目录: —" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Padding="8,6" ToolTipService.ToolTip="日志目录"/>
        <ListView x:Name="FileList" Grid.Row="1" SelectionChanged="OnFileSelected" SelectionMode="Single">
          <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="MinHeight" Value="36"/></Style></ListView.ItemContainerStyle>
          <ListView.ItemTemplate><DataTemplate><Grid ColumnDefinitions="Auto,*" Padding="4,2"><FontIcon Grid.Column="0" Glyph="&#xE81E;" FontSize="14" Margin="0,0,8,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Meta}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Grid></DataTemplate></ListView.ItemTemplate>
        </ListView>
      </Grid>
      <Rectangle Grid.Column="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}"/>
      <ListView x:Name="LogList" Grid.Column="2" SelectionMode="None" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollMode="Enabled" IsItemClickEnabled="False">
        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="MinHeight" Value="0"/></Style></ListView.ItemContainerStyle>
        <ListView.ItemTemplate><DataTemplate><StackPanel Padding="8,3"><Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*">
          <TextBlock Grid.Column="0" Text="{Binding LevelIcon}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Top"/>
          <TextBlock Grid.Column="1" Text="{Binding TimeDisplay}" FontSize="11" Foreground="#707070" FontFamily="Consolas" VerticalAlignment="Top" Margin="0,1,8,0"/>
          <TextBlock Grid.Column="2" Text="{Binding CategoryIcon}" FontSize="11" VerticalAlignment="Top" Margin="0,2,4,0"/>
          <TextBlock Grid.Column="3" Text="{Binding Tag}" FontSize="11" Foreground="#6AA9FF" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,1,8,0"/>
          <TextBlock Grid.Column="4" Text="{Binding Caller}" FontSize="10" Foreground="#5FA87A" FontFamily="Consolas" VerticalAlignment="Top" Margin="0,2,8,0" Visibility="{Binding CallerVisibility}"/>
          <TextBlock Grid.Column="5" Text="{Binding Message}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Top" IsTextSelectionEnabled="True" Foreground="{Binding ColorBrush}"/>
        </Grid></StackPanel></DataTemplate></ListView.ItemTemplate>
      </ListView>
    </Grid>
    <Grid Grid.Row="2" Padding="12,6" ColumnSpacing="16" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="SizeTxt" Grid.Column="0" Text="总大小: —" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="CountTxt" Grid.Column="1" Text="0 条" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Grid.Column="2"/><ToggleSwitch x:Name="AutoScrollSwitch" Grid.Column="3" Header="自动滚动" IsOn="True" MinWidth="110" Toggled="OnAutoScrollToggled"/><ToggleSwitch x:Name="WrapSwitch" Grid.Column="4" Header="自动换行" IsOn="True" MinWidth="110" Toggled="OnWrapToggled"/></Grid>
  </Grid>
</Window>




