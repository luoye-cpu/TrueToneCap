#!/bin/sh
# TrueToneCap pre-commit —— 只做快速构建校验（约 27s）
#
# 为什么这里只构建、不跑测试:
#   全量门禁 8 个套件约 110s。把它压在每次 commit 上，实际后果是人人都加 --no-verify，
#   于是钩子整体失效 —— 比没有钩子更糟（还多了一层"以为有保护"的错觉）。
#   所以：commit 只挡"编译不过"，测试移到 pre-push。
#
# 绕过: git commit --no-verify（紧急时可用，但请随后补跑 scripts/verify.ps1）
#
# 调试: TTC_HOOK_DRYRUN=1 sh scripts/git-hooks/pre-commit
#       只打印将要执行的命令行并退出 0，不启动任何子进程 ——
#       用于在没有外部进程权限 / 只想确认接线的环境里自查。

repo_root=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -z "$repo_root" ]; then
    # 2026-09-15 修正：原为「静默跳过 exit 0」。静默跳过 = 门禁无声失效，
    # 比没有钩子更危险（多一层"以为有保护"的错觉）。环境异常应显式阻断。
    echo "[pre-commit] ❌ 无法定位仓库根 —— 拒绝放行。" >&2
    echo "             确需跳过请用 git commit --no-verify，并随后补跑 scripts/verify.ps1" >&2
    exit 1
fi

verify="$repo_root/scripts/verify.ps1"
if [ ! -f "$verify" ]; then
    echo "[pre-commit] ❌ 未找到 $verify —— 拒绝放行（门禁脚本缺失）。" >&2
    echo "             请确认仓库完整；确需跳过用 git commit --no-verify" >&2
    exit 1
fi

# 选一个可用的宿主（2026-10-26 宿主策略定版）：默认 pwsh 7.x（当前 7.6.x 实测基线），
# Windows PowerShell 5.1 作基线回退 —— 5.1 只兜底、不做首选，7.x 才是有上游维护的宿主。
# 2026-10-26 优先 pwsh 并修正归因：5.1 并不缺 Get-FileHash（4.0 起就有）——
# 真正的问题是【继承的 PSModulePath 把 pwsh 7 的目录排在前面】时（ZCode / VS Code
# pwsh 终端 / Git Bash 会话都会这样继承），5.1 的模块解析抢先命中 pwsh 的
# Microsoft.PowerShell.Utility 清单，而它的程序集 .NET Framework 装不进去
# ⇒ Get-FileHash "命令不存在" ⇒ 门禁哈希校验必红（实测 "4/8 个场景不符"）。
# 双层防线：
#   ① 脚本层 —— verify.ps1/Publish.ps1/pack.ps1 的哈希全走 scripts/ps-compat.ps1
#     的 .NET 直调（Get-Sha256Hex），不依赖任何 cmdlet 解析；
#   ② 环境层 —— 本钩子回退 5.1 时用 env -u 擦掉继承的 PSModulePath，
#     让 5.1 重建自己的默认模块路径（其余 cmdlet 不再暴露在同一风险下）。
if command -v pwsh.exe >/dev/null 2>&1; then
    ps_exe="pwsh.exe"
elif command -v powershell.exe >/dev/null 2>&1; then
    ps_exe="powershell.exe"
else
    echo "[pre-commit] ❌ 未找到 powershell.exe / pwsh.exe —— 拒绝放行。" >&2
    echo "             Git Bash 下若 PATH 未含 PowerShell，请把其安装目录加入 PATH；" >&2
    echo "             确需跳过用 git commit --no-verify，并随后补跑 scripts/verify.ps1" >&2
    exit 1
fi

if [ -n "$TTC_HOOK_DRYRUN" ]; then
    echo "[pre-commit][dry-run] repo_root=$repo_root"
    echo "[pre-commit][dry-run] $ps_exe -NoProfile -ExecutionPolicy Bypass -File \"$verify\" -BuildOnly"
    exit 0
fi

echo "[pre-commit] 构建校验中（只构建，不跑测试；测试在 pre-push）..."
if [ "$ps_exe" = "powershell.exe" ]; then
    # 5.1 回退：擦掉继承的 PSModulePath（防 pwsh 路径遮蔽 5.1 自带模块，见上方注释）
    if env -u PSModulePath "$ps_exe" -NoProfile -ExecutionPolicy Bypass -File "$verify" -BuildOnly; then
        exit 0
    fi
else
    if "$ps_exe" -NoProfile -ExecutionPolicy Bypass -File "$verify" -BuildOnly; then
        exit 0
    fi
fi

echo "" >&2
echo "[pre-commit] ❌ 构建未通过，已阻止本次提交。" >&2
echo "             修复后重新 git commit；确需跳过用 git commit --no-verify，" >&2
echo "             但请随后补跑: $ps_exe -File scripts/verify.ps1" >&2
exit 1
